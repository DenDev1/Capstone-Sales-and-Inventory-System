@model leo.Models.Users

@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>LEOTECH</title>
    <link rel="icon" type="image/png" href="~/dist/img/logo.png" />
    
    <!-- Fonts -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    
    <!-- Styles -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/pages/login-premium.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/premium-toasts.css" asp-append-version="true" />
</head>
<body>

    <div id="toastContainer" class="toast-container"></div>

    <div class="login-split-container">
        <!-- Left Section -->
        <div class="login-left" style="background-image: url('@Url.Content("~/dist/img/login_bg.png")');">
            <div class="brand-section">
                <img src="~/dist/img/leotechs.jpg" alt="LeoTech" class="brand-logo" />
                <div class="brand-name">LEO<span>TECH</span></div>
            </div>

            <div class="footer-section">
                <span style="font-size: 0.8rem; color: #ffffff; font-weight: 600; opacity: 0.7;">© 2026 LEOTECH COMPUTER TRADING</span>
            </div>
        </div>

        <!-- Right Section -->
        <div class="login-right">
            <div class="login-form-wrapper">
                <h1>Welcome back</h1>
                <p class="subtitle">Sign in to your manager account.</p>

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size: 0.85rem; font-weight: 700;"></div>

                    <div class="form-group">
                        <label asp-for="Username">Username</label>
                        <input asp-for="Username" class="form-control-modern" placeholder="Enter your username" autofocus />
                        <span asp-validation-for="Username" class="text-danger" style="font-size: 0.75rem;"></span>
                    </div>

                    <div class="form-group" style="margin-bottom: 5px;">
                        <label asp-for="Password">Password</label>
                        <div class="password-wrapper">
                            <input asp-for="Password" type="password" class="form-control-modern" id="passwordField" placeholder="Enter your password" />
                            <i class="fas fa-eye password-toggle" id="togglePassword"></i>
                        </div>
                        <span asp-validation-for="Password" class="text-danger" style="font-size: 0.75rem;"></span>
                    </div>

                    <div class="form-options mb-4 d-flex justify-content-between align-items-center">
                        <div class="remember-me">
                            <input type="checkbox" id="rememberMe" name="rememberMe" value="true" />
                            <label for="rememberMe" class="ms-2 small fw-600 text-muted" style="cursor: pointer;">Remember me</label>
                        </div>
                        <a asp-controller="Login" asp-action="ForgotPassword" class="forgot-link">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn-login">
                        Sign in <i class="fas fa-arrow-right"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        window.LeotechToast = {
            show: function(message, type = 'success', title = '') {
                const container = document.getElementById('toastContainer');
                const toast = document.createElement('div');
                toast.className = `premium-toast ${type}`;
                if (!title) title = type.charAt(0).toUpperCase() + type.slice(1);
                const icons = { success: 'fa-check-circle', error: 'fa-exclamation-circle', warning: 'fa-exclamation-triangle', info: 'fa-info-circle' };
                toast.innerHTML = `<div class="toast-icon"><i class="fas ${icons[type]}"></i></div><div class="toast-content"><span class="title">${title}</span><span class="message">${message}</span></div>`;
                container.appendChild(toast);
                setTimeout(() => { toast.classList.add('toast-fade-out'); setTimeout(() => toast.remove(), 300); }, 4000);
            }
        };

        $(document).ready(function () {
            const logoutMsg = '@TempData["LogoutSuccess"]';
            const errorMsg = '@TempData["ErrorMessage"]';
            if (logoutMsg) LeotechToast.show(logoutMsg, 'info', 'Logged Out');
            if (errorMsg) LeotechToast.show(errorMsg, 'error', 'Error');

            $('#togglePassword').on('click', function () {
                const passwordField = $('#passwordField');
                const type = passwordField.attr('type') === 'password' ? 'text' : 'password';
                passwordField.attr('type', type);
                
                // Toggle eye icon
                $(this).toggleClass('fa-eye fa-eye-slash');
            });
        });
    </script>
</body>
</html>
