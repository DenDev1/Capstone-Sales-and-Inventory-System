@model leo.Models.PasswordResetRequest

@{
    Layout = null;
    ViewData["Title"] = "Create New Password";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>LEOTECH</title>
    <link rel="icon" type="image/png" href="~/dist/img/logo.png" />
    
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/pages/login-premium.css" asp-append-version="true" />
</head>
<body>

    <div class="login-split-container">
        <!-- Left Section -->
        <div class="login-left" style="background-image: url('@Url.Content("~/dist/img/login_bg.png")');">
            <div class="brand-section">
                <img src="~/dist/img/leotechs.jpg" alt="LeoTech" class="brand-logo" />
                <div class="brand-name">LEO<span>TECH</span></div>
            </div>
            <div class="footer-section">
                <span style="font-size: 0.8rem; color: #ffffff; font-weight: 600; opacity: 0.7;">© 2024 LEOTECH COMPUTER TRADING</span>
            </div>
        </div>

        <!-- Right Section -->
        <div class="login-right">
            <div class="login-form-wrapper">
                <h1>Create Password</h1>
                <p class="subtitle">Set a strong password to protect your manager account.</p>

                <form asp-action="ResetPassword" method="post">
                    <input type="hidden" name="Email" value="@ViewData["Email"]" />
                    <input type="hidden" name="Token" value="@ViewData["Token"]" />
                    
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size: 0.85rem; font-weight: 700;"></div>

                    <div class="form-group">
                        <label asp-for="NewPassword">New Password</label>
                        <div class="password-wrapper">
                            <input asp-for="NewPassword" type="password" class="form-control-modern" id="passwordField" placeholder="At least 8 characters" required autofocus />
                            <i class="fas fa-eye password-toggle" id="togglePassword"></i>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger" style="font-size: 0.75rem;"></span>
                    </div>

                    <button type="submit" class="btn-login">
                        Update Password <i class="fas fa-save"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#togglePassword').on('click', function () {
                const passwordField = $('#passwordField');
                const type = passwordField.attr('type') === 'password' ? 'text' : 'password';
                passwordField.attr('type', type);
                $(this).toggleClass('fa-eye fa-eye-slash');
            });

            // Prevent token leak in history
            if (window.history.replaceState) {
                window.history.replaceState(null, document.title, window.location.pathname);
            }
        });
    </script>
</body>
</html>
