@model leo.Models.Users

@{
    Layout = null;
    ViewData["Title"] = "Account Recovery";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>LEOTECH</title>
    <link rel="icon" type="image/png" href="~/dist/img/logo.png" />
    
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/pages/login-premium.css" asp-append-version="true" />
</head>
<body>

    <div class="login-split-container">
        <!-- Left Section -->
        <div class="login-left" style="background-image: url('@Url.Content("~/dist/img/login_bg.png")');">
            <div class="brand-section">
                <img src="~/dist/img/leotechs.jpg" alt="LeoTech" class="brand-logo" />
                <div class="brand-name">LEO<span>TECH</span></div>
            </div>
            <div class="footer-section">
                <span style="font-size: 0.8rem; color: #ffffff; font-weight: 600; opacity: 0.7;">© 2024 LEOTECH COMPUTER TRADING</span>
            </div>
        </div>

        <!-- Right Section -->
        <div class="login-right">
            <div class="login-form-wrapper">
                <h1>Account Recovery</h1>
                <p class="subtitle">Enter your email and we'll send a code to reset your password.</p>

                <form asp-action="ForgotPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size: 0.85rem; font-weight: 700;"></div>

                    <div class="form-group">
                        <label asp-for="Email">Registered Email</label>
                        <input asp-for="Email" type="email" class="form-control-modern" placeholder="e.g. manager@leotech.com" required autofocus />
                        <span asp-validation-for="Email" class="text-danger" style="font-size: 0.75rem;"></span>
                    </div>

                    <button type="submit" class="btn-login">
                        Send Recovery Code <i class="fas fa-paper-plane"></i>
                    </button>
                    
                    <div style="text-align: center; margin-top: 30px; font-size: 0.85rem; font-weight: 700;">
                        <span style="color: #64748b;">Remember your password?</span> 
                        <a asp-action="Index" style="color: #215B8B; text-decoration: none;">Back to Login</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
