@model IEnumerable<leo.Models.Inventory>
@{
    ViewData["Title"] = "Inventory Management";
    
    // KPI Data
    var totalProducts = Model.Count();
    var lowStockCount = Model.Count(x => x.StockQuantity <= 10 && x.StockQuantity > 0);
    var outOfStockCount = Model.Count(x => x.StockQuantity == 0);
    var inventoryValue = Model.Sum(x => x.UnitPrice * x.StockQuantity);
}

<link rel="stylesheet" href="~/css/pages/inventory-index.css" asp-append-version="true" />

<!-- Metadata for JS -->
<div id="metadata" 
     data-get-categories-url="@Url.Action("GetCategories", "Inventory")"
     data-create-category-url="@Url.Action("CreateCategory", "Inventory")"
     data-edit-category-url="@Url.Action("EditCategory", "Inventory")"
     data-delete-category-url="@Url.Action("DeleteCategory", "Inventory")"
     data-create-item-url="@Url.Action("Create", "Inventory")"
     style="display:none;"></div>

<div class="inventory-container">
    <div class="inventory-header">
        <div class="header-info">
            <h1><i class="fas fa-boxes"></i> Inventory Master List</h1>
            <p>Monitor stock levels, categories, and product performance</p>
        </div>
        <div class="header-actions">
            <div class="btn-group shadow-sm">
                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createInventoryModal">
                    <i class="fas fa-plus"></i> Add Item
                </button>
                <button type="button" class="btn btn-light" data-bs-toggle="modal" data-bs-target="#manageCategoriesModal">
                    <i class="fas fa-tags"></i> Categories
                </button>
                <a asp-action="DeletedProducts" class="btn btn-light">
                    <i class="fas fa-history"></i> Waste/Removed
                </a>
            </div>
        </div>
    </div>

    <!-- KPI Bar -->
    <div class="inv-kpi-bar">
        <div class="kpi-stat-card total">
            <div class="stat-icon"><i class="fas fa-box"></i></div>
            <div class="stat-content">
                <span class="label">Total SKUs</span>
                <div class="value">@totalProducts</div>
            </div>
        </div>
        <div class="kpi-stat-card low">
            <div class="stat-icon"><i class="fas fa-battery-quarter"></i></div>
            <div class="stat-content">
                <span class="label">Low Stock</span>
                <div class="value">@lowStockCount</div>
            </div>
        </div>
        <div class="kpi-stat-card out">
            <div class="stat-icon"><i class="fas fa-exclamation-triangle"></i></div>
            <div class="stat-content">
                <span class="label">Out of Stock</span>
                <div class="value">@outOfStockCount</div>
            </div>
        </div>
        <div class="kpi-stat-card value">
            <div class="stat-icon"><i class="fas fa-dollar-sign"></i></div>
            <div class="stat-content">
                <span class="label">Stock Value</span>
                <div class="value">@inventoryValue.ToString("N2")</div>
            </div>
        </div>
    </div>

    <!-- Main Table Card -->
    <div class="inv-card">
        <div class="card-toolbar">
            <div class="filter-group">
                <i class="fas fa-filter text-muted"></i>
                <select id="sortFilter" class="form-select form-select-sm" onchange="filterProductsByDate()" style="width: 140px;">
                    <option value="all">Sort: Default</option>
                    <option value="latest">Sort: Newest</option>
                    <option value="oldest">Sort: Oldest</option>
                </select>
                <select id="stockFilter" class="form-select form-select-sm" onchange="filterProductsByStock()" style="width: 160px;">
                    <option value="all">Status: All</option>
                    <option value="in-stock">In Stock</option>
                    <option value="low-stock">Low Stock</option>
                    <option value="out-of-stock">Out of Stock</option>
                </select>
            </div>
            <div class="search-area"></div>
        </div>

        <div class="table-responsive p-3">
            <table id="inventoryTable" class="table inv-table">
                <thead>
                    <tr>
                        <th width="80">Media</th>
                        <th>Product Details</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Qty</th>
                        <th>Status</th>
                        <th>Last Updated</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var statusClass = item.StockQuantity == 0 ? "out" : (item.StockQuantity <= 10 ? "low" : "in");
                        var statusText = item.StockQuantity == 0 ? "Out of Stock" : (item.StockQuantity <= 10 ? "Low Stock" : "In Stock");
                        var statusIcon = item.StockQuantity == 0 ? "fa-times-circle" : (item.StockQuantity <= 10 ? "fa-exclamation-circle" : "fa-check-circle");

                        <tr>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                                {
                                    <img src="@item.ImagePath" alt="@item.ProductName" class="prod-thumb" />
                                }
                                else
                                {
                                    <div class="prod-thumb d-flex align-items-center justify-content-center bg-light text-muted">
                                        <i class="fas fa-image"></i>
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="prod-details">
                                    <span class="name">@item.ProductName</span>
                                    <span class="barcode"><i class="fas fa-barcode"></i> @item.Barcode</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.Category?.CategoryName</span>
                            </td>
                            <td>
                                <span class="price-tag">₱@item.UnitPrice.ToString("N2")</span>
                            </td>
                            <td class="fw-bold">@item.StockQuantity</td>
                            <td>
                                <span class="stock-badge @statusClass">
                                    <i class="fas @statusIcon"></i> @statusText
                                </span>
                            </td>
                            <td class="text-muted" style="font-size: 0.8rem;">
                                @item.Date.ToString("MMM dd, yyyy")
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-light edit-inventory-btn"
                                            data-product-id="@item.ProductId"
                                            data-product-name="@item.ProductName"
                                            data-barcode="@item.Barcode"
                                            data-category-id="@item.CategoryId"
                                            data-date="@item.Date.ToString("yyyy-MM-ddTHH:mm")"
                                            data-unit-price="@item.UnitPrice"
                                            data-stock-quantity="@item.StockQuantity"
                                            data-description="@item.Description"
                                            data-suppliers="@item.Suppliers"
                                            data-image-path="@item.ImagePath">
                                        <i class="fas fa-edit text-primary"></i>
                                    </button>
                                    <form asp-action="Delete" asp-route-id="@item.ProductId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="button" class="btn btn-light" onclick="deleteInventoryItem(event)">
                                            <i class="fas fa-trash text-danger"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ================= MODALS ================= -->

<!-- Create Inventory Modal -->
<div class="modal fade modal-modern" id="createInventoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius: 20px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">New Inventory Entry</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="createInventoryForm" enctype="multipart/form-data">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">PRODUCT NAME</label>
                            <input name="productName" class="form-control rounded-8" placeholder="Enter product name" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">BARCODE</label>
                            <input name="barcode" class="form-control rounded-8" placeholder="Scan or enter barcode" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">CATEGORY</label>
                            <select id="categoryId" name="categoryId" class="form-select rounded-8" required></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">DATE</label>
                            <input type="datetime-local" name="date" class="form-control rounded-8" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">UNIT PRICE (₱)</label>
                            <input type="number" name="unitPrice" class="form-control rounded-8" step="0.01" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">INITIAL STOCK</label>
                            <input type="number" name="stockQuantity" class="form-control rounded-8" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">DESCRIPTION</label>
                            <textarea name="description" class="form-control rounded-8" rows="2" placeholder="Item details..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">PRODUCT IMAGE</label>
                            <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success px-5" onclick="createInventoryItem()" style="background: #10b981; border: none; font-weight: 700;">Save Entry</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Inventory Modal -->
<div class="modal fade modal-modern" id="editInventoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius: 20px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Update Inventory</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="editInventoryForm" asp-action="Edit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editId" name="id" />
                    <input type="hidden" id="editProductId" name="ProductId" />
                    <input type="hidden" id="editSuppliers" name="Suppliers" />
                    <input type="hidden" id="editImagePath" name="ImagePath" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">PRODUCT NAME</label>
                            <input type="text" id="editProductName" name="ProductName" class="form-control rounded-8" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">BARCODE</label>
                            <input type="text" id="editBarcode" name="Barcode" class="form-control rounded-8" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">CATEGORY</label>
                            <select id="editCategoryId" name="CategoryId" class="form-select rounded-8" required></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">DATE</label>
                            <input type="datetime-local" id="editDate" name="Date" class="form-control rounded-8" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">UNIT PRICE (₱)</label>
                            <input type="number" id="editUnitPrice" name="UnitPrice" class="form-control rounded-8" step="0.01" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">STOCK QUANTITY</label>
                            <input type="number" id="editStockQuantity" name="StockQuantity" class="form-control rounded-8" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">DESCRIPTION</label>
                            <textarea id="editDescription" name="Description" class="form-control rounded-8" rows="2"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">REPLACE IMAGE (OPTIONAL)</label>
                            <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="editInventoryForm" class="btn btn-primary px-5" style="background: #215B8B; border: none; font-weight: 700;">Update Item</button>
            </div>
        </div>
    </div>
</div>

<!-- Manage Categories Modal -->
<div class="modal fade" id="manageCategoriesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 20px;">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Manage Categories</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-4">
                    <label class="form-label fw-bold">Create New Category</label>
                    <div class="input-group">
                        <input type="text" id="categoryNameInput" class="form-control" placeholder="Office Supplies, Electronics, etc.">
                        <button class="btn btn-success" type="button" onclick="createCategory()">Add</button>
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-bold small text-muted">SEARCH CATEGORIES</label>
                    <div class="position-relative">
                        <i class="fas fa-search position-absolute" style="left: 15px; top: 12px; color: #94a3b8;"></i>
                        <input type="text" id="searchCategoryInput" class="form-control" placeholder="Search saved categories..." style="padding-left: 45px; border-radius: 10px; background: #f8fafc;">
                    </div>
                </div>

                <div class="table-responsive" style="max-height: 350px;">
                    <table class="table table-hover align-middle">
                        <tbody id="categoriesTableBody">
                            <!-- Categories load via JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Confirmation Modals -->
<div class="modal fade" id="deleteInventoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content text-center p-4" style="border-radius: 20px;">
            <div class="text-danger mb-3" style="font-size: 3rem;"><i class="fas fa-trash-alt"></i></div>
            <h4 class="fw-bold">Delete Item?</h4>
            <p class="text-muted small">This will move the item to the waste/removed log.</p>
            <div class="d-flex gap-2 mt-3">
                <button type="button" class="btn btn-light w-100" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger w-100" id="confirmDeleteButton">Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- (Similar modals for Category Delete and Category Edit can be kept or simplified) -->
<!-- Modal for Edit Category -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content p-4" style="border-radius: 20px;">
            <h5 class="fw-bold mb-3">Edit Category</h5>
            <input type="hidden" id="editCategoryId">
            <input type="text" id="editCategoryName" class="form-control mb-3">
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-light w-100" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary w-100" onclick="saveCategory()">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content text-center p-4" style="border-radius: 20px;">
            <div class="text-danger mb-3" style="font-size: 3rem;"><i class="fas fa-exclamation-circle"></i></div>
            <h5 class="fw-bold">Delete Category?</h5>
            <p class="text-muted small">All products in this category will become uncategorized.</p>
            <div class="d-flex gap-2 mt-3">
                <button type="button" class="btn btn-light w-100" data-bs-dismiss="modal">No</button>
                <button type="button" class="btn btn-danger w-100" onclick="confirmDeleteCategory()">Yes</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/inventory-index.js" asp-append-version="true"></script>
}
