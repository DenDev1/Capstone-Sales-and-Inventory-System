@model IEnumerable<leo.Models.Inventory>
@{
    ViewData["Title"] = "Archived Inventory";
}

<link rel="stylesheet" href="~/css/pages/deleted-products.css" asp-append-version="true" />

<div class="deleted-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-800" style="color: #1e293b;"><i class="fas fa-trash-alt me-2"></i> Archived Products</h1>
            <p class="text-muted">Items removed from active inventory. You can restore them or permanently delete them.</p>
        </div>
        <button class="btn btn-light rounded-pill px-4" onclick="window.location.href='@Url.Action("Index", "Inventory")'">
            <i class="fas fa-arrow-left me-2"></i> Back to Inventory
        </button>
    </div>

    <div class="deleted-card">
        <div class="p-4 border-bottom bg-light">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <span class="badge bg-danger rounded-pill px-3 py-2">
                        <i class="fas fa-archive me-1"></i> @Model.Count() Items Archived
                    </span>
                </div>
                <div class="col-md-6 text-end">
                    <!-- Search will be handled by DataTables -->
                </div>
            </div>
        </div>

        <div class="table-responsive p-0">
            <table id="deletedTable" class="table table-hover mb-0 deleted-table">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Product Identification</th>
                        <th>Original Category</th>
                        <th class="text-end pe-4">Restoration & Cleanup</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center py-2">
                                    <div class="rounded-3 bg-light p-2 me-3" style="width: 45px; height: 45px; display: flex; align-items: center; justify-content: center;">
                                        <i class="fas fa-box text-muted"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@product.ProductName</div>
                                        <div class="small text-muted">Barcode: @(product.Barcode ?? "N/A")</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border px-3 rounded-pill uppercase small fw-bold">
                                    @(product.Category?.CategoryName ?? "General")
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group">
                                    <a asp-action="Restore" asp-route-id="@product.ProductId" class="btn btn-outline-success btn-sm rounded-pill px-3 me-2">
                                        <i class="fas fa-undo"></i> Restore
                                    </a>
                                    <form asp-action="DeleteConfirmed" asp-route-id="@product.ProductId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="return confirm('Permanently delete this item? This cannot be undone.')">
                                            <i class="fas fa-trash-alt"></i> Hard Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5 text-muted">
                                <i class="fas fa-check-circle fa-3x mb-3 d-block opacity-25"></i>
                                <div class="fw-bold">No archived items found</div>
                                <div class="small">The trash bin is currently empty.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#deletedTable').DataTable({
                "responsive": true,
                "lengthChange": false,
                "autoWidth": false,
                "language": {
                    "search": "",
                    "searchPlaceholder": "Search archived products..."
                }
            });

            $('.dataTables_filter input').addClass('form-control shadow-none').css({
                'border-radius': '10px',
                'padding': '10px 15px',
                'width': '250px',
                'background': '#f8fafc'
            });
        });
    </script>
}
