@model IEnumerable<leo.Models.Role>
@{
    ViewData["Title"] = "System Roles";
}

<link rel="stylesheet" href="~/css/pages/roles-index.css" asp-append-version="true" />

<div class="roles-container">
    <div class="roles-header">
        <div class="header-info">
            <h1 class="fw-800" style="color: #1e293b;"><i class="fas fa-user-tag"></i> System Roles</h1>
            <p class="text-muted">Define and manage user permissions and access levels</p>
        </div>
        <div class="header-actions">
            <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#createRoleModal" style="background: #215B8B; border: none;">
                <i class="fas fa-plus-circle"></i> Create New Role
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
    }

    <!-- Table Card -->
    <div class="roles-card">
        <div class="table-responsive p-3">
            <table id="rolesTable" class="table roles-table">
                <thead>
                    <tr>
                        <th>Role Name</th>
                        <th>User Count (Linked)</th>
                        <th class="text-end">Management Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="role-badge-large">
                                    <i class="fas fa-shield-alt"></i>
                                    @item.RoleName
                                </div>
                            </td>
                            <td>
                                <span class="text-muted fw-bold">System Level</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <button type="button" class="btn btn-light btn-sm rounded-pill px-4 edit-role-btn" data-id="@item.RoleId">
                                        <i class="fas fa-edit text-primary me-1"></i> Update
                                    </button>
                                    <form asp-action="Delete" asp-route-id="@item.RoleId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="button" class="btn btn-light btn-sm rounded-pill px-3 ms-2 delete-role-btn" data-name="@item.RoleName">
                                            <i class="fas fa-trash text-danger"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ================= MODALS ================= -->

<!-- Create Role Modal -->
<div class="modal fade modal-modern" id="createRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-800">New Permission Level</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post">
                <div class="modal-body p-4">
                    <div class="form-group mb-3">
                        <label class="form-label small fw-bold text-muted">ROLE DESIGNATION</label>
                        <input name="RoleName" class="form-control" placeholder="e.g. Supervisor, Auditor" required 
                               style="height: 50px; border-radius: 12px; border: 2px solid #f1f5f9;" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-5" style="background: #215B8B; border: none; font-weight: 700; height: 50px; border-radius: 12px;">Create Role</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Role Modal -->
<div class="modal fade modal-modern" id="editRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-800">Update Role</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Edit" method="post">
                <input type="hidden" id="editRoleId" name="RoleId" />
                <div class="modal-body p-4">
                    <div id="editLoading" class="text-center py-4 d-none">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                    <div id="editFormContent">
                        <div class="form-group mb-3">
                            <label class="form-label small fw-bold text-muted">ROLE DESIGNATION</label>
                            <input name="RoleName" id="editRoleName" class="form-control" required 
                                   style="height: 50px; border-radius: 12px; border: 2px solid #f1f5f9;" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-5" style="background: #215B8B; border: none; font-weight: 700; height: 50px; border-radius: 12px;">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content text-center p-4" style="border-radius: 20px;">
            <div class="text-danger mb-3" style="font-size: 3rem;"><i class="fas fa-exclamation-triangle"></i></div>
            <h4 class="fw-800">Delete Role?</h4>
            <p id="deleteRoleText" class="text-muted small"></p>
            <div class="d-flex gap-2 mt-4">
                <button type="button" class="btn btn-light w-100" data-bs-dismiss="modal" style="border-radius: 10px; font-weight: 700;">Cancel</button>
                <button type="button" class="btn btn-danger w-100" id="btnConfirmDeleteRole" style="border-radius: 10px; font-weight: 700;">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#rolesTable').DataTable({
                "responsive": true,
                "lengthChange": false,
                "autoWidth": false,
                "language": {
                    "search": "",
                    "searchPlaceholder": "Search roles..."
                }
            });

            // Modernize search
            $('.dataTables_filter input').addClass('form-control').css({
                'border-radius': '10px',
                'padding': '10px 15px',
                'width': '220px',
                'background': '#f8fafc'
            });

            // AJAX for Edit
            $('.edit-role-btn').on('click', function() {
                const id = $(this).data('id');
                $('#editRoleId').val(id);
                $('#editFormContent').addClass('d-none');
                $('#editLoading').removeClass('d-none');
                $('#editRoleModal').modal('show');

                $.get(`/Roles/GetRoleDetails/${id}`, function(data) {
                    $('#editRoleName').val(data.roleName);
                    $('#editLoading').addClass('d-none');
                    $('#editFormContent').removeClass('d-none');
                });
            });

            // Delete Handling
            $('.delete-role-btn').on('click', function() {
                const form = $(this).closest('form');
                const name = $(this).data('name');
                $('#deleteRoleText').text(`Are you sure you want to delete the "${name}" role? Users assigned to this role may lose access.`);
                $('#deleteConfirmRoleModal').modal('show');
                
                $('#btnConfirmDeleteRole').off('click').on('click', function() {
                    form.submit();
                });
            });
        });
    </script>
}
