@model IEnumerable<leo.Models.Return>
@{
    ViewData["Title"] = "Customer Returns";
}

<link rel="stylesheet" href="~/css/pages/returns-index.css" asp-append-version="true" />

<div class="returns-container">
    <div class="returns-header">
        <div class="header-info">
            <h1 class="fw-800" style="color: #1e293b;"><i class="fas fa-undo me-2"></i> Product Returns</h1>
            <p class="text-muted">Manage warranty claims and product return requests</p>
        </div>
        <div class="header-actions">
            @if (User.IsInRole("Staff"))
            {
                <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#createReturnModal">
                    <i class="fas fa-plus-circle me-1"></i> New Return Request
                </button>
            }
        </div>
    </div>

    <div class="ret-card">
        <div class="table-responsive">
            <table id="returnsTable" class="table table-hover mb-0 ret-table">
                <thead>
                    <tr>
                        <th class="ps-4">Product Info</th>
                        <th>Customer</th>
                        <th class="text-center">Qty</th>
                        <th>Reason for Return</th>
                        <th>Status</th>
                        <th>Dates</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th class="text-end pe-4">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@item.Product?.ProductName</div>
                                <div class="small text-muted">SKU: @(item.Product?.Barcode ?? "N/A")</div>
                            </td>
                            <td>
                                <div class="fw-bold">@item.CustomerName</div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border fw-bold">@item.QuantityReturned</span>
                            </td>
                            <td>
                                <div class="small" style="max-width: 200px; white-space: normal;">@item.Reason</div>
                            </td>
                            <td>
                                @if (item.Status == ReturnStatus.UnderWarranty)
                                {
                                    <span class="status-badge-ret bg-warning" style="color: #92400e; background: #fef3c7;">Under Warranty</span>
                                }
                                else if (item.Status == ReturnStatus.Rejected)
                                {
                                    <span class="status-badge-ret bg-danger" style="color: #991b1b; background: #fee2e2;">Rejected</span>
                                }
                                else if (item.Status == ReturnStatus.Approved)
                                {
                                    <span class="status-badge-ret bg-success" style="color: #065f46; background: #dcfce7;">Approved</span>
                                }
                            </td>
                            <td>
                                <div class="small text-muted mb-1"><i class="far fa-calendar-alt"></i> Return: @item.ReturnDate.ToString("MMM dd, yyyy")</div>
                                <div class="small text-muted"><i class="far fa-clock"></i> Order: @item.OrderDate.ToString("MMM dd, yyyy")</div>
                            </td>
                            @if (User.IsInRole("Admin"))
                            {
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        @if (item.Status == ReturnStatus.UnderWarranty)
                                        {
                                            <form asp-action="Approve" asp-route-id="@item.ReturnId" method="post" class="d-inline me-1">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-success rounded-pill px-3">Approve</button>
                                            </form>
                                            <form asp-action="Reject" asp-route-id="@item.ReturnId" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger rounded-pill px-3">Reject</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Processed</span>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create Return Modal -->
<div class="modal fade" id="createReturnModal" tabindex="-1" aria-labelledby="createReturnModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-800" id="createReturnModalLabel" style="color: #1e293b;">
                    <i class="fas fa-plus-circle text-primary me-2"></i> New Return Request
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-action="Create" method="post" id="createReturnForm">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold small text-muted">Product</label>
                                <select name="ProductId" id="ModalProductId" class="form-select select2-modal" required>
                                    <option value="">Select a Product</option>
                                    @foreach (var item in (SelectList)ViewBag.ProductId)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold small text-muted">Quantity Returned</label>
                                <input name="QuantityReturned" type="number" class="form-control rounded-pill" placeholder="Enter quantity" required min="1" />
                            </div>
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold small text-muted">Customer Name</label>
                                <input name="CustomerName" type="text" class="form-control rounded-pill" placeholder="Enter name" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold small text-muted">Status</label>
                                <select name="Status" class="form-select rounded-pill">
                                    <option value="UnderWarranty">Under Warranty</option>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <option value="Approved">Approved</option>
                                        <option value="Rejected">Rejected</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold small text-muted">Order Date</label>
                                <input name="OrderDate" type="date" class="form-control rounded-pill" required />
                            </div>
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold small text-muted">Reason</label>
                                <textarea name="Reason" class="form-control" style="border-radius: 12px; height: 100px;" placeholder="Reason for return..." required></textarea>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0 pb-4 px-4">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="createReturnForm" class="btn btn-primary rounded-pill px-5 shadow-sm">Save Request</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#returnsTable').DataTable({
                "responsive": true,
                "lengthChange": false,
                "autoWidth": false,
                "language": {
                    "search": "",
                    "searchPlaceholder": "Search returns..."
                }
            });

            $('.dataTables_filter input').addClass('form-control shadow-none').css({
                'border-radius': '10px',
                'padding': '10px 15px',
                'width': '250px',
                'background': '#f8fafc'
            });

            // Handle Select2 inside Modal
            $('#createReturnModal').on('shown.bs.modal', function () {
                $('.select2-modal').select2({
                    dropdownParent: $('#createReturnModal'),
                    width: '100%'
                });
            });

            // Immediate feedback when clicking Save
            $('#createReturnForm').on('submit', function() {
                if (window.LeotechToast) {
                    LeotechToast.show('Processing return request...', 'info');
                }
            });

            // Show toast on return success if needed (Layout handles it via TempData)
        });
    </script>
}
