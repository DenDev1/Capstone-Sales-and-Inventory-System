@model IEnumerable<leo.Models.Return>
@{
    ViewData["Title"] = "Customer Returns";
}

<link rel="stylesheet" href="~/css/pages/returns-index.css" asp-append-version="true" />

<div class="returns-container">
    <div class="returns-header">
        <div class="header-info">
            <h1 class="fw-800" style="color: #1e293b;"><i class="fas fa-undo me-2"></i> Product Returns</h1>
            <p class="text-muted">Manage warranty claims and product return requests</p>
        </div>
        <div class="header-actions">
            @if (User.IsInRole("Staff"))
            {
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
                    <i class="fas fa-plus-circle me-1"></i> New Return Request
                </a>
            }
        </div>
    </div>

    <div class="ret-card">
        <div class="table-responsive">
            <table id="example1" class="table table-hover mb-0 ret-table">
                <thead>
                    <tr>
                        <th class="ps-4">Product Info</th>
                        <th>Customer</th>
                        <th class="text-center">Qty</th>
                        <th>Reason for Return</th>
                        <th>Status</th>
                        <th>Dates</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th class="text-end pe-4">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@item.Product?.ProductName</div>
                                <div class="small text-muted">SKU: @(item.Product?.Barcode ?? "N/A")</div>
                            </td>
                            <td>
                                <div class="fw-bold">@item.CustomerName</div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border fw-bold">@item.QuantityReturned</span>
                            </td>
                            <td>
                                <div class="small" style="max-width: 200px; white-space: normal;">@item.Reason</div>
                            </td>
                            <td>
                                @if (item.Status == ReturnStatus.UnderWarranty)
                                {
                                    <span class="status-badge-ret bg-warning" style="color: #92400e; background: #fef3c7;">Under Warranty</span>
                                }
                                else if (item.Status == ReturnStatus.Rejected)
                                {
                                    <span class="status-badge-ret bg-danger" style="color: #991b1b; background: #fee2e2;">Rejected</span>
                                }
                                else if (item.Status == ReturnStatus.Approved)
                                {
                                    <span class="status-badge-ret bg-success" style="color: #065f46; background: #dcfce7;">Approved</span>
                                }
                            </td>
                            <td>
                                <div class="small text-muted mb-1"><i class="far fa-calendar-alt"></i> Return: @item.ReturnDate.ToString("MMM dd, yyyy")</div>
                                <div class="small text-muted"><i class="far fa-clock"></i> Order: @item.OrderDate.ToString("MMM dd, yyyy")</div>
                            </td>
                            @if (User.IsInRole("Admin"))
                            {
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        @if (item.Status == ReturnStatus.UnderWarranty)
                                        {
                                            <form asp-action="Approve" asp-route-id="@item.ReturnId" method="post" class="d-inline me-1">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-success rounded-pill px-3">Approve</button>
                                            </form>
                                            <form asp-action="Reject" asp-route-id="@item.ReturnId" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger rounded-pill px-3">Reject</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Processed</span>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#example1').DataTable({
                "responsive": true,
                "lengthChange": false,
                "autoWidth": false,
                "language": {
                    "search": "",
                    "searchPlaceholder": "Search returns..."
                }
            });

            $('.dataTables_filter input').addClass('form-control shadow-none').css({
                'border-radius': '10px',
                'padding': '10px 15px',
                'width': '250px',
                'background': '#f8fafc'
            });
        });
    </script>
}
