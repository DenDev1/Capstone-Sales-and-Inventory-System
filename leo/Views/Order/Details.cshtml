@model leo.ViewModels.OrderDetailsViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Products Summary</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .store-info {
            text-align: center;
            margin-bottom: 20px;
        }

            .store-info h2 {
                margin: 0;
                font-size: 1.5rem;
                font-weight: bold;
            }

            .store-info p {
                margin: 0;
                font-size: 0.9rem;
            }

        .invoice-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

            .invoice-header img {
                max-height: 50px;
            }

            .invoice-header h1 {
                font-size: 1.5rem;
                margin: 0;
            }

        .invoice-details {
            margin-bottom: 20px;
        }

            .invoice-details p {
                margin: 5px 0;
                font-size: 0.9rem;
            }

        .invoice-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

            .invoice-table th, .invoice-table td {
                border: 1px solid #dddddd;
                padding: 8px;
                text-align: left;
                font-size: 0.9rem;
            }

            .invoice-table th {
                background-color: #f9f9f9;
                font-weight: bold;
            }

            .invoice-table td {
                background-color: #ffffff;
            }

        .total-amount {
            font-weight: bold;
            font-size: 1.1rem;
            text-align: right;
            margin-top: 20px;
        }

        .btn-custom {
            border: none;
            padding: 0.5rem 1rem;
            font-size: 0.9rem;
            border-radius: 3px;
            cursor: pointer;
        }

        .btn-print {
            background-color: #007bff;
            color: #ffffff;
        }

        .btn-back {
            background-color: #6c757d;
            color: #ffffff;
        }

        .btn-clear {
            background-color: #dc3545;
            color: #ffffff;
        }

        @@media print {
            .no-print {
                display: none !important;
            }

            body * {
                visibility: hidden;
            }

            #printContent, #printContent * {
                visibility: visible;
            }

            #printContent {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="container" id="printContent">
        <div class="store-info">
            <h2>LEOTECH COMPUTER STORE</h2>
            <p>107 Lakandula St, Cebu City, 6000 Cebu</p>
            <p>Contact No.: 0922-702-5592</p>
        </div>

        <div class="invoice-header">
            <h1>All Products Summary</h1>
            <img src="~/dist/img/leotechs.jpg" alt="Logo" class="img-fluid" />
        </div>

        <div class="invoice-details">
            <p><strong>Generated on:</strong> @DateTime.Now.ToString("MMMM dd yyyy hh:mm tt")</p>
        </div>

        <table class="invoice-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Order ID</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Total</th>
                    <th>Payment Status</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int counter = 1;
                    foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td>@counter</td>
                            <td>@order.OrderId</td>
                            <td>@order.OrderDate.ToString("MM/dd/yyyy")</td>
                            <td>@order.CustomerName</td>
                            <td>@order.Product.ProductName</td>
                            <td>@order.Quantity</td>
                            <td>@order.UnitPrice.ToString("C", new System.Globalization.CultureInfo("fil-PH"))</td>
                            <td>@((order.Quantity * order.UnitPrice).ToString("C", new System.Globalization.CultureInfo("fil-PH")))</td>
                            <td>@order.PaymentStatus</td>
                        </tr>
                        counter++;
                    }
                }
            </tbody>
        </table>

        <div class="total-amount">
            <strong>Grand Total Amount: </strong>
            @Model.TotalAmount.ToString("C", new System.Globalization.CultureInfo("fil-PH"))
        </div>
    </div>

    <div class="container mt-4 no-print">
        <div class="d-flex justify-content-between">
            <button class="btn-custom btn-back" onclick="window.location.href='@Url.Action("Create", "Order")'">Back to Orders</button>
            <button class="btn-custom btn-print" onclick="printAllProducts()">Print Summary</button>
        </div>
       
    </div>

    <script>
        function printAllProducts() {
            var printContents = document.getElementById('printContent').innerHTML;
            var originalContents = document.body.innerHTML;

            document.body.innerHTML = printContents;
            window.print();
            document.body.innerHTML = originalContents;
        }
    </script>
</body>
</html>