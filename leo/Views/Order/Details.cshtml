@model leo.ViewModels.OrderDetailsViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Products Summary - LEOTECH</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
        }

        .header {
            text-align: center;
            margin-bottom: 20px;
        }

        .store-name {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .address {
            margin-bottom: 5px;
        }

        .summary-title {
            text-align: center;
            margin: 20px 0;
            font-size: 20px;
        }

        .generated-date {
            text-align: right;
            margin-bottom: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }

        th {
            background-color: #f2f2f2;
        }

        .grand-total {
            text-align: right;
            font-weight: bold;
            font-size: 18px;
            margin-top: 20px;
        }

        .footer {
            text-align: center;
            margin-top: 40px;
            font-size: 12px;
            color: #666;
        }

        .no-print {
            margin-top: 20px;
        }

        @@media print {
            .no-print {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="store-name">LEOTECH COMPUTER STORE</div>
        <div class="address">107 Lakandula St, Cebu City, 6000 Cebu</div>
        <div class="contact">Contact No.: 0922-702-5592</div>
    </div>

    <hr>

    <div class="summary-title">All Products Summary</div>

    <div class="generated-date">
        <strong>Generated on:</strong> @DateTime.Now.ToString("MMMM dd yyyy hh:mm tt")
    </div>

    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Order ID</th>
                <th>Date</th>
                <th>Customer</th>
                <th>Product</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Total</th>
                <th>Payment Status</th>
            </tr>
        </thead>
        <tbody>
            @{
                int counter = 1;
                foreach (var order in Model.Orders)
                {
                    <tr>
                        <td>@counter</td>
                        <td>@order.OrderId</td>
                        <td>@order.OrderDate.ToString("MM/dd/yyyy")</td>
                        <td>@order.CustomerName</td>
                        <td>@order.Product.ProductName</td>
                        <td>@order.Quantity</td>
                        <td>P@(order.UnitPrice.ToString("N2"))</td>
                        <td>P@((order.Quantity * order.UnitPrice).ToString("N2"))</td>
                        <td>@order.PaymentStatus</td>
                    </tr>
                    counter++;
                }
            }
        </tbody>
    </table>

    <div class="grand-total">
        <strong>Grand Total Amount:</strong> P@(Model.TotalAmount.ToString("N2"))
    </div>

    <div class="footer">
        Copyright © @DateTime.Now.Year LEOTECH. All rights reserved.
    </div>

    <div class="no-print">
        <button onclick="window.print()" style="padding: 10px 20px; background: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;">Print Summary</button>
        <a href="@Url.Action("Create")" style="padding: 10px 20px; background: #6c757d; color: white; border: none; border-radius: 4px; text-decoration: none; margin-left: 10px;">Back to Orders</a>
    </div>
</body>
</html>