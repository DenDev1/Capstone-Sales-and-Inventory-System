@model leo.ViewModels.OrderDetailsViewModel
@{
    Layout = null;
    var firstOrder = Model.Orders.FirstOrDefault();
    var customerName = firstOrder?.CustomerName ?? "Walking Customer";
    var referenceNo = firstOrder?.ReferenceNo?.Split('-').Last() ?? "INV-0000";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice @referenceNo - LEOTECH</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/pages/invoice-modern.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body class="invoice-rendering">

    <div class="modern-invoice">
        <!-- Header Section -->
        <div class="invoice-header-modern">
            <div class="brand-section">
                <h1>LEOTECH COMPUTER STORE</h1>
                <p class="text-muted small mb-0">107 Lakandula St, Cebu City</p>
                <p class="text-muted small">0922-702-5592 · leotech@store.com</p>
                <div class="invoice-label">Official Invoice</div>
            </div>
            <div class="meta-section">
                <h2>INVOICE</h2>
                <div class="mt-3">
                    <p class="mb-0 small fw-bold text-muted text-uppercase">Reference</p>
                    <p class="fw-bold text-primary">#@referenceNo</p>
                </div>
                <div>
                    <p class="mb-0 small fw-bold text-muted text-uppercase">Issue Date</p>
                    <p class="fw-bold">@DateTime.Now.ToString("MMMM dd, yyyy")</p>
                </div>
            </div>
        </div>

        <div class="invoice-body">
            <!-- Customer Info -->
            <div class="row mb-5">
                <div class="col-6">
                    <div class="bill-to">
                        <label>Bill To</label>
                        <div class="name">@customerName</div>
                        <div class="small text-muted">Customer Account</div>
                    </div>
                </div>
                <div class="col-6 text-end">
                    <div class="bill-to">
                        <label>Payment Method</label>
                        <div class="fw-bold text-uppercase">@(firstOrder?.PaymentStatus.ToString() ?? "CASH")</div>
                    </div>
                </div>
            </div>

            <!-- Items Table -->
            <table class="invoice-table-modern">
                <thead>
                    <tr>
                        <th width="50%">Description</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@order.Product?.ProductName</div>
                                <div class="small text-muted">SKU: @(order.Barcode ?? "N/A")</div>
                            </td>
                            <td class="text-center fw-bold">@order.Quantity</td>
                            <td class="text-end">₱@order.UnitPrice.ToString("N2")</td>
                            <td class="text-end fw-bold">₱@((order.Quantity * order.UnitPrice).ToString("N2"))</td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Summary -->
            <div class="invoice-summary-modern">
                <div class="summary-box">
                    <div class="summary-row">
                        <span class="text-muted fw-bold small text-uppercase">Subtotal</span>
                        <span class="fw-bold">₱@Model.TotalAmount.ToString("N2")</span>
                    </div>
                    <div class="summary-row">
                        <span class="text-muted fw-bold small text-uppercase">Tax (0%)</span>
                        <span class="fw-bold">₱0.00</span>
                    </div>
                    <div class="summary-row grand-total">
                        <span class="fw-800 text-uppercase" style="color: #64748b; font-size: 0.8rem;">Amount Due</span>
                        <span class="fw-800">₱@Model.TotalAmount.ToString("N2")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="invoice-footer-modern">
            <div>
                <p class="mb-0 fw-bold">Thank you for your purchase!</p>
                <p class="mb-0 small">Warranty valid for 7 days with original receipt.</p>
            </div>
            <div class="text-end">
                <p class="mb-0 small fw-bold text-uppercase">Verified By</p>
                <p class="mb-0 text-dark fw-bold">LEOTECH Management</p>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="no-print">
        <button onclick="window.print()" class="btn btn-primary btn-lg rounded-pill px-5 me-3 shadow">
            <i class="fas fa-print me-2"></i> Print Official Invoice
        </button>
        <a href="@Url.Action("Create")" class="btn btn-light btn-lg rounded-pill px-5 border">
            <i class="fas fa-arrow-left me-2"></i> Return to POS
        </a>
    </div>

</body>
</html>
