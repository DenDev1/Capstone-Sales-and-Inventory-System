@model Order

@{
    var initialProductsJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.PosProducts ?? new object[0]);
    var initialProducts = ViewBag.PosProducts as System.Collections.IEnumerable;
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var productIcons = new[] { "📦", "🏷️", "✨", "🔥", "💎", "🌟", "⚡", "🌈" };
}

<div class="pos-wrapper">
    @Html.AntiForgeryToken()
    <div class="pos-header">
        <h1><i class="fas fa-cash-register"></i> LEOTECH POS System</h1>
        <div class="header-info">
            <span id="currentTime"><i class="far fa-clock"></i> Loading...</span>
        </div>
    </div>

    <div class="pos-main">
        <div class="products-section">
            <div class="products-header">
                <h2><i class="fas fa-th-large"></i> Products</h2>
                <div class="products-search-wrapper" style="flex: 1; max-width: 400px; position: relative;">
                    <i class="fas fa-search" style="position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: #94a3b8;"></i>
                    <input type="text" id="searchProducts" class="search-bar" placeholder="Search products or scan barcode..." style="padding-left: 45px;" />
                </div>
            </div>

            <!-- Categories Filter -->
            <div class="categories-filter" style="display: flex; gap: 10px; overflow-x: auto; padding-bottom: 5px; margin-bottom: 5px;">
                <button class="btn-category active" onclick="filterByCategory('all')" data-category="all" 
                    style="padding: 8px 20px; border-radius: 10px; border: 1px solid #e2e8f0; background: white; font-weight: 700; white-space: nowrap; cursor: pointer; transition: all 0.2s;">
                    All Items
                </button>
                @foreach (var cat in categories)
                {
                    <button class="btn-category" onclick="filterByCategory('@cat.CategoryName')" data-category="@cat.CategoryName"
                        style="padding: 8px 20px; border-radius: 10px; border: 1px solid #e2e8f0; background: white; font-weight: 700; white-space: nowrap; cursor: pointer; transition: all 0.2s;">
                        @cat.CategoryName
                    </button>
                }
            </div>

            <div class="products-grid" id="productsGrid">
                @{ var productIndex = 0; }
                @if (initialProducts != null)
                {
                    foreach (var product in initialProducts)
                    {
                        var productType = product?.GetType();
                        var productId = Convert.ToString(productType?.GetProperty("ProductId")?.GetValue(product));
                        var productName = Convert.ToString(productType?.GetProperty("ProductName")?.GetValue(product)) ?? "Product";
                        var unitPrice = Convert.ToDecimal(productType?.GetProperty("UnitPrice")?.GetValue(product) ?? 0m);
                        var imagePath = Convert.ToString(productType?.GetProperty("ImagePath")?.GetValue(product));
                        var categoryName = Convert.ToString(productType?.GetProperty("CategoryName")?.GetValue(product)) ?? "Uncategorized";
                        var icon = productIcons[productIndex % productIcons.Length];
                        productIndex++;

                        <div class="product-card" 
                             data-product-id="@productId" 
                             data-product-name="@productName" 
                             data-product-price="@unitPrice"
                             data-category="@categoryName"
                             onclick="addToCart('@productId', '@productName.Replace("'", "\\'")', @unitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                            
                            @{
                                var description = Convert.ToString(productType?.GetProperty("Description")?.GetValue(product)) ?? "No description available.";
                                var escapedDesc = description.Replace("'", "\\'").Replace("\r\n", " ").Replace("\n", " ");
                            }
                            
                            <div class="info-btn" title="View Details" onclick="event.stopPropagation(); showDescription('@productName.Replace("'", "\\'")', '@escapedDesc')">
                                <i class="fas fa-info"></i>
                            </div>

                            <div class="product-icon">
                                @if (!string.IsNullOrWhiteSpace(imagePath))
                                {
                                    <img src="@imagePath" alt="@productName" style="width:100%;height:100%;object-fit:cover;" />
                                }
                                else
                                {
                                    @icon
                                }
                            </div>
                            <div class="product-name">@productName</div>
                            <div class="product-price">₱@unitPrice.ToString("N2")</div>
                            <div style="font-size: 0.7rem; color: #94a3b8; margin-top: -5px;">@categoryName</div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="checkout-section">
            <div class="checkout-header">
                <i class="fas fa-shopping-basket"></i> Cart Summary
            </div>

            <div class="checkout-items" id="checkoutItems">
                <div class="empty-cart">
                    <i class="fas fa-shopping-cart fa-3x" style="opacity: 0.2; margin-bottom: 10px;"></i>
                    <span>No items selected</span>
                </div>
            </div>

            <div class="checkout-totals">
                <div class="total-row">
                    <span>Subtotal</span>
                    <span>₱<span id="subtotal">0.00</span></span>
                </div>
                <div class="total-row final">
                    <span>Total</span>
                    <span class="final-total-value">₱<span id="total">0.00</span></span>
                </div>
            </div>

            <div class="customer-info">
                <div style="position: relative;">
                    <i class="fas fa-user" style="position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: #94a3b8;"></i>
                    <input type="text" id="customerName" placeholder="Customer Name" style="padding-left: 45px;" />
                </div>
            </div>

            <div id="paymentFeedback" class="payment-feedback"></div>
            <div id="paymentErrorDetails" class="payment-error-details"></div>

            <div class="payment-method-group">
                <label><i class="fas fa-credit-card"></i> Payment Method</label>
                <div class="payment-options">
                    <div class="payment-option">
                        <input type="radio" id="paymentCash" name="paymentMethod" value="Cash" checked />
                        <label for="paymentCash"><i class="fas fa-money-bill-wave"></i> Cash</label>
                    </div>
                    <div class="payment-option">
                        <input type="radio" id="paymentOnline" name="paymentMethod" value="FullyPaid" />
                        <label for="paymentOnline"><i class="fas fa-mobile-alt"></i> Online</label>
                    </div>
                </div>
            </div>

            <div class="action-buttons">
                <button type="button" id="printInvoiceBtn" class="btn-print" onclick="printInvoice()" hidden>
                    <i class="fas fa-print"></i> Print Invoice
                </button>
                <div class="checkout-buttons">
                    <button type="button" class="btn btn-cancel" onclick="clearCart()">
                        <i class="fas fa-trash"></i> Clear
                    </button>
                    <button type="button" class="btn btn-hold" onclick="holdOrder()">
                        <i class="fas fa-pause"></i> Hold
                    </button>
                    <button type="button" class="btn btn-checkout" onclick="completeCheckout()">
                        Pay ₱<span id="btnTotal">0.00</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        window.orderCreateConfig = {
            getProductsUrl: '@Url.Action("GetProducts", "Inventory")',
            checkoutUrl: '@Url.Action("Checkout", "Order")',
            createOrderUrl: '@Url.Action("Create", "Order")',
            initialProducts: @Html.Raw(initialProductsJson)
        };

        function showDescription(name, desc) {
            Swal.fire({
                title: `<span style="color: #215B8B; font-weight: 800;">${name}</span>`,
                html: `<div style="text-align: left; font-family: 'Manrope', sans-serif; color: #4b5563; line-height: 1.6;">${desc}</div>`,
                icon: 'info',
                confirmButtonText: 'Got it!',
                confirmButtonColor: '#215B8B',
                customClass: {
                    popup: 'premium-swal-popup',
                    title: 'premium-swal-title'
                },
                showClass: {
                    popup: 'animate__animated animate__fadeInUp animate__faster'
                },
                hideClass: {
                    popup: 'animate__animated animate__fadeOutDown animate__faster'
                }
            });
        }
    </script>
    <script src="~/js/order-create.js" asp-append-version="true"></script>
}
