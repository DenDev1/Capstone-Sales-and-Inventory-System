@using System.Globalization
@using System.Text.Json
@model leo.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    var currency = new CultureInfo("en-PH");
    var canViewTotalSales = !User.IsInRole("Staff");
}



<div class="dash-shell">
    <section class="dash-hero">
        <h1>LEOTECH Analytics Center</h1>
        <p>Monitor products, stocks, suppliers, and sales performance in one modern workspace.</p>
    </section>

    <section class="stats-grid">
        <article class="stat-card">
            <div class="stat-head">
                <span class="stat-label">Products</span>
                <span class="stat-pill pill-1"><i class="fas fa-cube"></i></span>
            </div>
            <div class="stat-value">@Model.ProductCount</div>
        </article>
        <article class="stat-card">
            <div class="stat-head">
                <span class="stat-label">Suppliers</span>
                <span class="stat-pill pill-2"><i class="fas fa-truck"></i></span>
            </div>
            <div class="stat-value">@Model.SupplierCount</div>
        </article>
        <article class="stat-card">
            <div class="stat-head">
                <span class="stat-label">Staff</span>
                <span class="stat-pill pill-3"><i class="fas fa-users"></i></span>
            </div>
            <div class="stat-value">@Model.UsersCount</div>
        </article>
        <article class="stat-card">
            <div class="stat-head">
                <span class="stat-label">Sales Records</span>
                <span class="stat-pill pill-4"><i class="fas fa-chart-line"></i></span>
            </div>
            <div class="stat-value">@Model.SalesCount</div>
        </article>
        <article class="stat-card">
            <div class="stat-head">
                <span class="stat-label">Stocks</span>
                <span class="stat-pill pill-6"><i class="fas fa-boxes"></i></span>
            </div>
            <div class="stat-value">@Model.StockCount</div>
        </article>
        @if (canViewTotalSales)
        {
            <article class="stat-card">
                <div class="stat-head">
                    <span class="stat-label">Total Sales</span>
                    <span class="stat-pill pill-5"><i class="fas fa-coins"></i></span>
                </div>
                <div class="stat-value">@Model.TotalSales.ToString("C", currency)</div>
            </article>
        }
    </section>

    <section class="dash-panels">
        <article class="panel panel-trend">
            <h3>Sales Trend (Quantity Ordered)</h3>
            <div class="chart-wrap">
                <canvas id="productSalesChart"></canvas>
            </div>
        </article>

        <article class="panel panel-stock">
            <h3>Low Stock Alerts</h3>
            <div class="simple-list stock-list">
                @if (Model.LowStockItems != null && Model.LowStockItems.Any())
                {
                    foreach (var item in Model.LowStockItems)
                    {
                        <div class="simple-item low-stock">
                            <strong>@item.ProductName</strong>
                            <span>@item.Quantity item(s) left</span>
                        </div>
                    }
                }
                else
                {
                    <div class="simple-item">
                        <strong>All good</strong>
                        <span>No low-stock products right now.</span>
                    </div>
                }
            </div>
        </article>
    </section>

    <section class="dash-panels">
        <article class="panel">
            <h3>Latest Products</h3>
            <div class="simple-list">
                @if (Model.LatestProducts != null && Model.LatestProducts.Any())
                {
                    foreach (var product in Model.LatestProducts)
                    {
                        <div class="simple-item">
                            <strong>@product.ProductName</strong>
                            <span>@product.Price.ToString("C", currency) | Stock: @product.StockQuantity</span>
                        </div>
                    }
                }
                else
                {
                    <div class="simple-item">
                        <strong>No data yet</strong>
                        <span>Latest products will appear here.</span>
                    </div>
                }
            </div>
        </article>

        <article class="panel">
            <h3>Top Selling Products</h3>
            <div class="simple-list">
                @if (Model.TopSellingProducts != null && Model.TopSellingProducts.Any())
                {
                    foreach (var product in Model.TopSellingProducts)
                    {
                        <div class="simple-item">
                            <strong>@product.ProductName</strong>
                            <span>Sold: @product.TotalSold | Price: @product.Price.ToString("C", currency)</span>
                        </div>
                    }
                }
                else
                {
                    <div class="simple-item">
                        <strong>No data yet</strong>
                        <span>Top selling products will appear here.</span>
                    </div>
                }
            </div>
        </article>
    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const chartElement = document.getElementById('productSalesChart');
            if (!chartElement) {
                return;
            }

            const ctx = chartElement.getContext('2d');
            const quantities = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyProductQuantities != null ? Model.MonthlyProductQuantities : new System.Collections.Generic.List<int>()));
            const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: months,
                    datasets: [{
                        label: 'Quantity Ordered',
                        data: quantities,
                        borderColor: '#0f766e',
                        backgroundColor: 'rgba(15,118,110,0.16)',
                        borderWidth: 3,
                        tension: 0.35,
                        fill: true,
                        pointRadius: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: { grid: { display: false } },
                        y: { beginAtZero: true }
                    }
                }
            });
        });
    </script>
}


