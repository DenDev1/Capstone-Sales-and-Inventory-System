@model IEnumerable<leo.Models.TransactionHistory>
@{
    ViewData["Title"] = "Transaction History";
    
    // KPI Calculations
    var totalTxns = Model.Count();
    var pendingCount = Model.Count(x => x.TransactionType?.ToLower() == "pending");
    var deliveredCount = Model.Count(x => x.TransactionType?.ToLower() == "delivered");
    var noticeCount = Model.Count(x => x.TransactionType?.ToLower() == "notice");
}

<link rel="stylesheet" href="~/css/pages/transactions-index.css" asp-append-version="true" />

<div class="transactions-container">
    <!-- Header -->
    <div class="transactions-header">
        <div class="header-info">
            <h1><i class="fas fa-history"></i> Transaction History</h1>
            <p>Complete audit log of supplier requests and delivered stock</p>
        </div>
        <div class="header-actions">
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#clearHistoryModal">
                <i class="fas fa-trash-alt"></i> Clear Audit Log
            </button>
        </div>
    </div>

    <!-- KPI Bar -->
    <div class="txn-kpi-bar">
        <div class="kpi-stat-card total">
            <div class="stat-icon"><i class="fas fa-layer-group"></i></div>
            <div class="stat-content">
                <span class="label">Total Records</span>
                <div class="value">@totalTxns</div>
            </div>
        </div>
        <div class="kpi-stat-card pending">
            <div class="stat-icon"><i class="fas fa-hourglass-half"></i></div>
            <div class="stat-content">
                <span class="label">Pending</span>
                <div class="value">@pendingCount</div>
            </div>
        </div>
        <div class="kpi-stat-card delivered">
            <div class="stat-icon"><i class="fas fa-truck"></i></div>
            <div class="stat-content">
                <span class="label">Delivered</span>
                <div class="value">@deliveredCount</div>
            </div>
        </div>
        <div class="kpi-stat-card notice">
            <div class="stat-icon"><i class="fas fa-exclamation-circle"></i></div>
            <div class="stat-content">
                <span class="label">Notices</span>
                <div class="value">@noticeCount</div>
            </div>
        </div>
    </div>

    <!-- Table Section -->
    <div class="txn-card">
        <div class="card-toolbar">
            <div class="filter-options">
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-light active filter-btn" data-filter="all">All</button>
                    <button type="button" class="btn btn-light filter-btn" data-filter="Pending">Pending</button>
                    <button type="button" class="btn btn-light filter-btn" data-filter="Delivered">Delivered</button>
                    <button type="button" class="btn btn-light filter-btn" data-filter="Notice">Notice</button>
                </div>
            </div>
            <div class="search-wrap">
                <!-- DataTables Search will inject here or we keep our own -->
            </div>
        </div>

        <div class="table-responsive">
            <table id="txnTable" class="table txn-table">
                <thead>
                    <tr>
                        <th>Supplier</th>
                        <th>Description</th>
                        <th>Requested Items</th>
                        <th>Date & Time</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var txn in Model)
                    {
                        var type = (txn.TransactionType ?? "Default").ToLower();
                        var pillClass = type switch
                        {
                            "delivered" => "delivered",
                            "pending" => "pending",
                            "notice" => "notice",
                            "requested" => "requested",
                            _ => "default"
                        };
                        var iconClass = type switch
                        {
                            "delivered" => "fa-circle",
                            "pending" => "fa-clock",
                            "notice" => "fa-exclamation",
                            "requested" => "fa-paper-plane",
                            _ => "fa-info-circle"
                        };

                        <tr data-status="@txn.TransactionType">
                            <td class="supplier-cell">
                                @(txn.Supplier?.SupplierName ?? "N/A")
                            </td>
                            <td>
                                @(string.IsNullOrEmpty(txn.Description) ? "No description" : txn.Description)
                            </td>
                            <td style="max-width: 300px;" class="text-truncate" title="@txn.ProductsAndQuantities">
                                @(string.IsNullOrEmpty(txn.ProductsAndQuantities) ? "No items" : txn.ProductsAndQuantities)
                            </td>
                            <td class="date-cell">
                                @txn.TransactionDate.ToString("MMM dd, yyyy · hh:mm tt")
                            </td>
                            <td>
                                <span class="status-pill @pillClass">
                                    <i class="fas @iconClass"></i> @txn.TransactionType
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="clearHistoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 20px;">
            <div class="modal-header">
                <h5 class="modal-title" style="font-weight: 800;">Secure Archive</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <div style="width: 80px; height: 80px; background: rgba(239, 68, 68, 0.1); color: #ef4444; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-size: 2rem;">
                    <i class="fas fa-trash"></i>
                </div>
                <h4 style="font-weight: 800; color: #1e293b;">Clear Audit Log?</h4>
                <p style="color: #64748b; font-weight: 600;">This action will permanently delete all transaction records and cannot be undone.</p>
            </div>
            <div class="modal-footer pb-4 px-4">
                <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal" style="font-weight: 700;">Cancel</button>
                <form asp-controller="TransactionHistories" asp-action="ClearHistory" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger px-4" style="font-weight: 700; background: #ef4444; border: none;">Confirm Deletion</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            var table = $('#txnTable').DataTable({
                "responsive": true,
                "lengthChange": false,
                "autoWidth": false,
                "dom": '<"top"f>rt<"bottom"ip><"clear">',
                "language": {
                    "search": "",
                    "searchPlaceholder": "Search history..."
                }
            });

            // Status Filter Logic
            $('.filter-btn').on('click', function() {
                $('.filter-btn').removeClass('btn-primary active').addClass('btn-light');
                $(this).removeClass('btn-light').addClass('btn-primary active');
                
                var category = $(this).data('filter');
                if(category === 'all') {
                    table.column(4).search('').draw();
                } else {
                    // Exact match for category in column 4 (Status)
                    table.column(4).search('^' + category + '$', true, false).draw();
                }
            });

            // Modernize search input
            $('.dataTables_filter input').addClass('form-control').css({
                'border-radius': '10px',
                'padding': '10px 15px',
                'width': '250px'
            });
        });
    </script>
}
