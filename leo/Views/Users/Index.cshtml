@model IEnumerable<leo.Models.Users>
@{
    ViewData["Title"] = "User Management";
}

<link rel="stylesheet" href="~/css/pages/users-index.css" asp-append-version="true" />

<div class="users-container">
    <div class="users-header">
        <div class="header-info">
            <h1><i class="fas fa-users-cog"></i> User Management</h1>
            <p>Control system access and manage staff credentials</p>
        </div>
        <div class="header-actions">
            <button type="button" class="btn btn-success rounded-pill px-4 py-2" data-bs-toggle="modal" data-bs-target="#createUserModal">
                <i class="fas fa-plus-circle"></i> Add New Staff
            </button>
        </div>
    </div>

    <!-- Main Table Card -->
    <div class="users-card">
        <div class="table-responsive p-3">
            <table id="usersTable" class="table users-table">
                <thead>
                    <tr>
                        <th>Identity</th>
                        <th>Email Address</th>
                        <th>Account Role</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <div class="staff-identity">
                                    <div class="user-avatar">
                                        @(user.FirstName?.Substring(0, 1))@(user.LastName?.Substring(0, 1))
                                    </div>
                                    <div class="staff-info">
                                        <span class="staff-name">@user.FirstName @user.LastName</span>
                                        <span class="staff-username">@@@user.Username</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div style="font-weight: 600; color: #475569;">@user.Email</div>
                                <div style="font-size: 0.75rem; color: #94a3b8;">Registered User</div>
                            </td>
                            <td>
                                @{
                                    var role = user.Roles?.RoleName?.ToLower() ?? "default";
                                    var pillClass = role switch {
                                        "admin" => "admin",
                                        "staff" => "staff",
                                        _ => "default"
                                    };
                                }
                                <span class="role-pill @pillClass">@user.Roles?.RoleName</span>
                            </td>
                            <td>
                                <div class="btn-group">
                                    <button type="button" class="btn btn-light btn-sm rounded-pill px-3 edit-user-btn" 
                                            data-id="@user.UserId">
                                        <i class="fas fa-edit text-primary"></i> Update
                                    </button>
                                    <button type="button" class="btn btn-light btn-sm rounded-pill px-3 delete-user-btn" 
                                            data-id="@user.UserId" data-name="@user.FirstName @user.LastName">
                                        <i class="fas fa-trash text-danger"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- CREATE MODAL -->
<div class="modal fade modal-modern" id="createUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New Staff</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="createUserForm" asp-action="Create" method="post">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">First Name</label>
                            <input name="FirstName" class="form-control-modern" placeholder="e.g. John" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Last Name</label>
                            <input name="LastName" class="form-control-modern" placeholder="e.g. Doe" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Email Address</label>
                            <input name="Email" type="email" class="form-control-modern" placeholder="john.doe@leotech.com" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Username</label>
                            <input name="Username" class="form-control-modern" placeholder="jdoe24" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Password</label>
                            <input name="Password" type="password" class="form-control-modern" placeholder="••••••••" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">System Role</label>
                            <select name="RoleId" class="form-select form-control-modern" asp-items="ViewBag.RoleId"></select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn px-4" data-bs-dismiss="modal" style="font-weight: 700;">Cancel</button>
                    <button type="submit" class="btn btn-success btn-modern px-5" style="background: #10b981; border: none;">
                        <i class="fas fa-user-plus"></i> Create Account
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- EDIT MODAL -->
<div class="modal fade modal-modern" id="editUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Update Staff Member</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editUserForm" asp-action="Edit" method="post">
                <input type="hidden" id="editUserId" name="UserId" />
                <div class="modal-body">
                    <div id="editLoading" class="text-center py-4 d-none">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2 text-muted">Fetching user details...</p>
                    </div>
                    <div id="editFormContent" class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">First Name</label>
                            <input name="FirstName" id="editFirstName" class="form-control-modern" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Last Name</label>
                            <input name="LastName" id="editLastName" class="form-control-modern" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Email Address</label>
                            <input name="Email" id="editEmail" type="email" class="form-control-modern" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Username</label>
                            <input name="Username" id="editUsername" class="form-control-modern" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Change Password</label>
                            <input name="Password" type="password" class="form-control-modern" placeholder="Leave empty to keep" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">System Role</label>
                            <select name="RoleId" id="editRoleId" class="form-select form-control-modern" asp-items="ViewBag.RoleId"></select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn px-4" data-bs-dismiss="modal" style="font-weight: 700;">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-modern px-5" style="background: #215B8B; border: none;">
                        <i class="fas fa-save"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade" id="deleteUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 20px;">
            <div class="modal-header border-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <div style="width: 70px; height: 70px; background: rgba(239, 68, 68, 0.1); color: #ef4444; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-size: 1.5rem;">
                    <i class="fas fa-user-times"></i>
                </div>
                <h4 style="font-weight: 800; color: #1e293b;">Delete Staff?</h4>
                <p id="deleteUserName" style="color: #64748b; font-weight: 600;"></p>
            </div>
            <div class="modal-footer border-0 pb-4 justify-content-center">
                <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal" style="font-weight: 700;">No, Keep</button>
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger px-4" style="font-weight: 700; background: #ef4444;">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // DataTables
            $('#usersTable').DataTable({
                "responsive": true,
                "lengthChange": false,
                "autoWidth": false,
                "language": {
                    "search": "",
                    "searchPlaceholder": "Search staff..."
                }
            });

            // Modernize search
            $('.dataTables_filter input').addClass('form-control-modern').css({
                'width': '250px',
                'height': '40px',
                'font-size': '0.85rem'
            });

            // Populate Edit Modal via AJAX
            $('.edit-user-btn').on('click', function() {
                const userId = $(this).data('id');
                $('#editUserId').val(userId);
                $('#editFormContent').addClass('d-none');
                $('#editLoading').removeClass('d-none');
                $('#editUserModal').modal('show');

                $.get(`/Users/GetUserDetails/${userId}`, function(data) {
                    $('#editFirstName').val(data.firstName);
                    $('#editLastName').val(data.lastName);
                    $('#editEmail').val(data.email);
                    $('#editUsername').val(data.username);
                    $('#editRoleId').val(data.roleId);
                    
                    $('#editLoading').addClass('d-none');
                    $('#editFormContent').removeClass('d-none');
                });
            });

            // AJAX for Submit Create
            $('#createUserForm').on('submit', function(e) {
                e.preventDefault();
                const form = $(this);
                
                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    data: form.serialize(),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function(response) {
                        if (response.success) {
                            $('#createUserModal').modal('hide');
                            LeotechToast.show(response.message, 'success');
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            LeotechToast.show(response.message, 'error');
                        }
                    },
                    error: function() {
                        LeotechToast.show('An error occurred while creating staff.', 'error');
                    }
                });
            });

            // AJAX for Submit Edit
            $('#editUserForm').on('submit', function(e) {
                e.preventDefault();
                const form = $(this);
                const id = $('#editUserId').val();
                
                $.ajax({
                    url: `${form.attr('action')}/${id}`,
                    type: 'POST',
                    data: form.serialize(),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function(response) {
                        if (response.success) {
                            $('#editUserModal').modal('hide');
                            LeotechToast.show(response.message, 'success');
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            LeotechToast.show(response.message, 'error');
                        }
                    },
                    error: function() {
                        LeotechToast.show('An error occurred while updating staff.', 'error');
                    }
                });
            });

            // Delete Modal
            $('.delete-user-btn').on('click', function() {
                const userId = $(this).data('id');
                const userName = $(this).data('name');
                $('#deleteUserName').text(`Are you sure you want to remove ${userName}?`);
                $('#deleteForm').attr('action', `/Users/Delete/${userId}`);
                $('#deleteUserModal').modal('show');
            });

            $('#deleteForm').on('submit', function() {
                LeotechToast.show('Removing staff member...', 'info');
            });
        });
    </script>
}
