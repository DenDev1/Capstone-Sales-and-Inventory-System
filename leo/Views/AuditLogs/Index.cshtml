@model IEnumerable<leo.Models.AuditLog>
@{
    ViewData["Title"] = "Security Audit Logs";
    
    // KPI Data
    var totalLogs = Model.Count();
    var checkoutCount = Model.Count(x => x.Action?.ToLower().Contains("checkout") == true);
    var adminActions = Model.Count(x => x.UserRole?.ToLower() == "admin");
    var criticalActions = Model.Count(x => x.Action?.ToLower().Contains("delete") == true || x.Action?.ToLower().Contains("clear") == true);
}

<link rel="stylesheet" href="~/css/pages/audit-logs.css" asp-append-version="true" />

<div class="audit-container">
    <!-- Header -->
    <div class="audit-header">
        <div class="header-info">
            <h1><i class="fas fa-shield-alt"></i> Security Audit Logs</h1>
            <p>Real-time monitoring of system activities and user actions</p>
        </div>
        <div class="header-actions">
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#clearAuditModal">
                <i class="fas fa-broom"></i> Clear Logs
            </button>
        </div>
    </div>

    <!-- KPI Bar -->
    <div class="audit-kpi-bar">
        <div class="kpi-stat-card total">
            <div class="stat-icon"><i class="fas fa-list-ul"></i></div>
            <div class="stat-content">
                <span class="label">Total Activities</span>
                <div class="value">@totalLogs</div>
            </div>
        </div>
        <div class="kpi-stat-card checkout">
            <div class="stat-icon"><i class="fas fa-cash-register"></i></div>
            <div class="stat-content">
                <span class="label">POS Checkouts</span>
                <div class="value">@checkoutCount</div>
            </div>
        </div>
        <div class="kpi-stat-card admin">
            <div class="stat-icon"><i class="fas fa-user-shield"></i></div>
            <div class="stat-content">
                <span class="label">Admin Actions</span>
                <div class="value">@adminActions</div>
            </div>
        </div>
        <div class="kpi-stat-card critical">
            <div class="stat-icon"><i class="fas fa-exclamation-triangle"></i></div>
            <div class="stat-content">
                <span class="label">Critical Actions</span>
                <div class="value">@criticalActions</div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="audit-card">
        <div class="table-responsive p-3">
            <table id="auditTable" class="table audit-table">
                <thead>
                    <tr>
                        <th>Action Entity</th>
                        <th>Details</th>
                        <th>Timestamp</th>
                        <th>Operator</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.OrderByDescending(x => x.DateOfAction))
                    {
                        var action = (log.Action ?? "Default").ToLower();
                        var pillClass = "default";
                        var icon = "fa-info-circle";

                        if (action.Contains("add") || action.Contains("create")) { pillClass = "add"; icon = "fa-plus-circle"; }
                        else if (action.Contains("checkout")) { pillClass = "checkout"; icon = "fa-shopping-cart"; }
                        else if (action.Contains("update") || action.Contains("modify") || action.Contains("change")) { pillClass = "modify"; icon = "fa-edit"; }
                        else if (action.Contains("delete") || action.Contains("remove") || action.Contains("clear")) { pillClass = "delete"; icon = "fa-trash-alt"; }

                        <tr>
                            <td>
                                <span class="action-pill @pillClass">
                                    <i class="fas @icon"></i> @log.Action
                                </span>
                            </td>
                            <td class="description-cell">
                                <div style="font-weight: 600; color: #1e293b;">@log.Description</div>
                            </td>
                            <td style="font-size: 0.85rem; color: #64748b; font-weight: 700;">
                                @log.DateOfAction.ToString("MMM dd, yyyy · hh:mm tt")
                            </td>
                            <td>
                                <div class="d-flex flex-column">
                                    <span class="role-badge @(log.UserRole?.ToLower() == "admin" ? "admin" : "user")">
                                        @(log.UserRole ?? "User")
                                    </span>
                                    <span class="email-cell mt-1">@log.Email</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Clear Modal -->
<div class="modal fade" id="clearAuditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 20px;">
            <div class="modal-header">
                <h5 class="modal-title" style="font-weight: 800;">Log Management</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <div style="width: 80px; height: 80px; background: rgba(239, 68, 68, 0.1); color: #ef4444; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-size: 2rem;">
                    <i class="fas fa-shield-virus"></i>
                </div>
                <h4 style="font-weight: 800; color: #1e293b;">Wipe Audit Logs?</h4>
                <p style="color: #64748b; font-weight: 600;">You are about to delete the entire system audit trail. This is a critical action.</p>
            </div>
            <div class="modal-footer pb-4 px-4">
                <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal" style="font-weight: 700;">Cancel</button>
                <form asp-controller="Auditlogs" asp-action="ClearHistory" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger px-4" style="font-weight: 700;">Confirm Wipe</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#auditTable').DataTable({
                "responsive": true,
                "lengthChange": false,
                "autoWidth": false,
                "order": [[2, 'desc']],
                "language": {
                    "search": "",
                    "searchPlaceholder": "Search activity logs..."
                }
            });

            // Style DataTables Search
            $('.dataTables_filter input').addClass('form-control form-control-modern').css({
                'border-radius': '10px',
                'padding': '10px 15px',
                'width': '280px',
                'background': '#f8fafc',
                'border': '1px solid #e2e8f0'
            });
        });
    </script>
}
