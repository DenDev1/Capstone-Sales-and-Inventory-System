@model leo.ViewModels.SalesIndexViewModel
@using System.Globalization

@{
    var culture = new CultureInfo("en-PH");
    var salesTrendLabels = System.Text.Json.JsonSerializer.Serialize(Model.SalesTrends.Select(x => x.DateLabel));
    var salesTrendData = System.Text.Json.JsonSerializer.Serialize(Model.SalesTrends.Select(x => x.Revenue));
    
    var topProductLabels = System.Text.Json.JsonSerializer.Serialize(Model.TopProducts.Select(x => x.ProductName));
    var topProductData = System.Text.Json.JsonSerializer.Serialize(Model.TopProducts.Select(x => x.Revenue));

    var paymentLabels = System.Text.Json.JsonSerializer.Serialize(Model.PaymentMethods.Select(x => x.Method));
    var paymentData = System.Text.Json.JsonSerializer.Serialize(Model.PaymentMethods.Select(x => x.Revenue));
}

<div class="analytics-container">
    <!-- Header & Filters -->
    <div class="analytics-header">
        <div class="header-title">
            <h1><i class="fas fa-chart-line"></i> Sales Analytics</h1>
            <p>Performance insights and financial summary</p>
        </div>
        <div class="header-filters">
            @using (Html.BeginForm("Index", "Sales", FormMethod.Get, new { @class = "filter-form" }))
            {
                <div class="filter-group">
                    <div class="date-input">
                        <label>Start Date</label>
                        <input type="date" name="StartDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control" />
                    </div>
                    <div class="date-input">
                        <label>End Date</label>
                        <input type="date" name="EndDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control" />
                    </div>
                    <div class="search-input">
                        <label>Search Product</label>
                        <div class="input-with-icon">
                            <i class="fas fa-search"></i>
                            <input type="text" name="searchQuery" value="@Model.SearchQuery" placeholder="Filter by item..." class="form-control" />
                        </div>
                    </div>
                    <div class="filter-actions">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-filter"></i> Apply</button>
                        <a href="@Url.Action("Index", "Sales")" class="btn btn-light"><i class="fas fa-undo"></i></a>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="kpi-grid">
        <div class="kpi-card revenue">
            <div class="kpi-icon"><i class="fas fa-wallet"></i></div>
            <div class="kpi-content">
                <span class="kpi-label">Total Revenue</span>
                <h3 class="kpi-value">@((Model.TotalProfit ?? 0).ToString("C", culture))</h3>
            </div>
            <div class="kpi-trend positive"><i class="fas fa-chart-line"></i> Summary View</div>
        </div>
        <div class="kpi-card orders">
            <div class="kpi-icon"><i class="fas fa-shopping-bag"></i></div>
            <div class="kpi-content">
                <span class="kpi-label">Sales Count</span>
                <h3 class="kpi-value">@Model.TotalTransactions</h3>
            </div>
            <div class="kpi-trend">Total Volume</div>
        </div>
        <div class="kpi-card aov">
            <div class="kpi-icon"><i class="fas fa-tag"></i></div>
            <div class="kpi-content">
                <span class="kpi-label">Avg. Order Value</span>
                <h3 class="kpi-value">@Model.AverageOrderValue.ToString("C", culture)</h3>
            </div>
            <div class="kpi-trend">Per Transaction</div>
        </div>
        <div class="kpi-card best-seller">
            <div class="kpi-icon"><i class="fas fa-star"></i></div>
            <div class="kpi-content">
                <span class="kpi-label">Top Product</span>
                <h3 class="kpi-value" style="font-size: 1.1rem;">@(Model.TopProducts.FirstOrDefault()?.ProductName ?? "N/A")</h3>
            </div>
            <div class="kpi-trend">Highest Revenue</div>
        </div>
    </div>

    <!-- Visualization Grid -->
    <div class="viz-grid">
        <!-- Sales Trend Line Chart -->
        <div class="viz-card trend">
            <div class="card-header">
                <h3><i class="fas fa-history"></i> Revenue Trend</h3>
            </div>
            <div class="chart-container">
                <canvas id="salesTrendChart"></canvas>
            </div>
        </div>

        <!-- Top Products Bar Chart -->
        <div class="viz-card products">
            <div class="card-header">
                <h3><i class="fas fa-trophy"></i> Top 5 Products</h3>
            </div>
            <div class="chart-container">
                <canvas id="topProductsChart"></canvas>
            </div>
        </div>

        <!-- Payment Method Doughnut Chart -->
        <div class="viz-card payments">
            <div class="card-header">
                <h3><i class="fas fa-credit-card"></i> Payment Methods</h3>
            </div>
            <div class="chart-container">
                <canvas id="paymentMethodChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Data Tables -->
    <div class="data-grid">
        <div class="table-card transactions">
            <div class="card-header">
                <h3><i class="fas fa-list-ul"></i> Recent Transactions</h3>
            </div>
            <div class="table-wrapper">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Product</th>
                            <th>Qty</th>
                            <th>Total</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.DailySales.Take(10))
                        {
                            <tr>
                                <td>@item.OrderDate.ToString("hh:mm tt")</td>
                                <td class="item-name">@item.ProductName</td>
                                <td>@item.Quantity</td>
                                <td class="price">@item.TotalAmount.ToString("C", culture)</td>
                                <td>
                                    <span class="status-badge @(item.PaymentMethod.ToLower().Contains("cash") ? "cash" : "online")">
                                        @item.PaymentMethod
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="table-card monthly">
            <div class="card-header">
                <h3><i class="fas fa-calendar-alt"></i> Monthly Summary</h3>
            </div>
            <div class="table-wrapper">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>Month</th>
                            <th>Sales Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.MonthlySales)
                        {
                            <tr>
                                <td>@item.Month</td>
                                <td class="price font-weight-bold">@item.TotalSales.ToString("C", culture)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Sales Trend Chart
        new Chart(document.getElementById('salesTrendChart'), {
            type: 'line',
            data: {
                labels: @Html.Raw(salesTrendLabels),
                datasets: [{
                    label: 'Revenue',
                    data: @Html.Raw(salesTrendData),
                    borderColor: '#215B8B',
                    backgroundColor: 'rgba(33, 91, 139, 0.1)',
                    fill: true,
                    tension: 0.4,
                    pointRadius: 4,
                    pointBackgroundColor: '#215B8B'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, grid: { borderDash: [5, 5] } },
                    x: { grid: { display: false } }
                }
            }
        });

        // Top Products Chart
        new Chart(document.getElementById('topProductsChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(topProductLabels),
                datasets: [{
                    label: 'Revenue',
                    data: @Html.Raw(topProductData),
                    backgroundColor: [
                        '#215B8B', '#1e40af', '#3b82f6', '#60a5fa', '#93c5fd'
                    ],
                    borderRadius: 8
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } }
            }
        });

        // Payment Method Chart
        new Chart(document.getElementById('paymentMethodChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(paymentLabels),
                datasets: [{
                    data: @Html.Raw(paymentData),
                    backgroundColor: ['#215B8B', '#3498db', '#f59e0b'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { usePointStyle: true, padding: 20 } }
                },
                cutout: '70%'
            }
        });
    </script>
}
