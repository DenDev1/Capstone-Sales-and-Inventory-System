@model IEnumerable<leo.ViewModels.SupplierViewModel>
@{
    ViewData["Title"] = "Supply Chain Management";
    
    // KPI Data
    var totalRequests = Model.Count();
    var pendingRequests = Model.Count(x => x.Status == "Requested" || x.Status == "Pending");
    var inTransit = Model.Count(x => x.Status == "Notice");
    var completed = Model.Count(x => x.Status == "Delivered");
}

<link rel="stylesheet" href="~/css/pages/suppliers-index.css" asp-append-version="true" />

<!-- Metadata for JS -->
<div id="metadata" 
     data-get-edit-url="@Url.Action("GetEditData", "Suppliers")"
     style="display:none;"></div>

<div id="successMessageData" data-value="@TempData["LoginSuccess"]" style="display:none;"></div>

<div class="overlay" id="loadingOverlay">
    <div class="spinner"></div>
    <div class="success-message" id="successMessage"></div>
</div>

<div class="suppliers-container">
    <!-- Header -->
    <div class="suppliers-header">
        <div class="header-info">
            <h1><i class="fas fa-truck-loading"></i> Supply Chain Management</h1>
            <p>Track delivery requests, supplier status, and procurement fulfillment</p>
        </div>
        <div class="header-actions">
            <button type="button" class="btn btn-success rounded-pill px-4 py-2" data-bs-toggle="modal" data-bs-target="#createSupplierModal">
                <i class="fas fa-plus-circle"></i> New Delivery Request
            </button>
        </div>
    </div>

    <!-- KPI Bar -->
    <div class="sup-kpi-bar">
        <div class="kpi-stat-card total">
            <div class="stat-icon"><i class="fas fa-list-check"></i></div>
            <div class="stat-content">
                <span class="label">Total Requests</span>
                <div class="value">@totalRequests</div>
            </div>
        </div>
        <div class="kpi-stat-card pending">
            <div class="stat-icon"><i class="fas fa-clock"></i></div>
            <div class="stat-content">
                <span class="label">Awaiting Arrival</span>
                <div class="value">@pendingRequests</div>
            </div>
        </div>
        <div class="kpi-stat-card transit">
            <div class="stat-icon"><i class="fas fa-shipping-fast"></i></div>
            <div class="stat-content">
                <span class="label">In Transit</span>
                <div class="value">@inTransit</div>
            </div>
        </div>
        <div class="kpi-stat-card delivered">
            <div class="stat-icon"><i class="fas fa-check-double"></i></div>
            <div class="stat-content">
                <span class="label">Fulfilled</span>
                <div class="value">@completed</div>
            </div>
        </div>
    </div>

    <!-- Main Table Card -->
    <div class="sup-card">
        <div class="toolbar p-3 d-flex justify-content-between align-items-center bg-light border-bottom">
            <div class="d-flex gap-3 align-items-center">
                <i class="fas fa-filter text-muted"></i>
                <select id="statusFilter" class="form-select form-select-sm" onchange="filterSuppliers()" style="width: 180px;">
                    <option value="all">Status: All</option>
                    <option value="Requested">Requested</option>
                    <option value="Pending">Pending Approval</option>
                    <option value="Notice">Notice/Transit</option>
                    <option value="Delivered">Delivered</option>
                </select>
            </div>
            <div class="search-area"></div>
        </div>

        <div class="table-responsive p-3">
            <table id="supplierTable" class="table sup-table">
                <thead>
                    <tr>
                        <th width="150">Request Date</th>
                        <th>Supplier Info</th>
                        <th>Procurement Items</th>
                        <th>Status</th>
                        <th class="text-end">Management Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var supplier in Model.OrderByDescending(x => x.ProductDate))
                    {
                        var statusClass = supplier.Status?.ToLower() ?? "unknown";
                        if (statusClass == "notice") statusClass = "transit";
                        
                        <tr>
                            <td class="text-muted fw-bold">
                                @supplier.ProductDate.ToString("MMM dd, yyyy")
                                <div style="font-size: 0.75rem; font-weight: normal;">@supplier.ProductDate.ToString("hh:mm tt")</div>
                            </td>
                            <td>
                                <div class="request-details">
                                    <span class="supplier">@supplier.SupplierName</span>
                                    <span class="email"><i class="fas fa-envelope"></i> @supplier.Email</span>
                                </div>
                            </td>
                            <td>
                                <div class="item-pills">
                                    @{
                                        var items = (supplier.ProductsAndQuantities ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries);
                                        foreach (var item in items.Skip(1)) // Skip header
                                        {
                                            <span class="item-pill">@item</span>
                                        }
                                        if (items.Length <= 1 && !string.IsNullOrEmpty(supplier.ProductName))
                                        {
                                            <span class="item-pill">@supplier.ProductName | @supplier.Quantity</span>
                                        }
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(supplier.Description))
                                {
                                    <div class="mt-1 text-muted small" style="font-style: italic;">"@supplier.Description"</div>
                                }
                            </td>
                            <td>
                                <span class="status-pill @statusClass">
                                    <i class="fas @(statusClass switch { "delivered" => "fa-check", "transit" => "fa-truck", "pending" => "fa-hourglass-half", _ => "fa-circle" })"></i>
                                    @supplier.Status
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    @if (supplier.Status == "Notice")
                                    {
                                        <form method="post" asp-action="MarkAsDelivered" asp-route-supplierId="@supplier.SupplierId" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success btn-action-sm">
                                                <i class="fas fa-clipboard-check"></i> Mark Received
                                            </button>
                                        </form>
                                    }
                                    
                                    <div class="dropdown">
                                        <button class="btn btn-light btn-sm rounded-pill dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                            Manage
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4">
                                            <li>
                                                <form method="post" asp-action="SendEmail" asp-route-supplierId="@supplier.SupplierId">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item py-2">
                                                        <i class="fas fa-paper-plane text-primary me-2"></i> Send Notification Email
                                                    </button>
                                                </form>
                                            </li>
                                            <li>
                                                <button type="button" class="dropdown-item py-2 edit-supplier-btn" data-supplier-id="@supplier.SupplierId">
                                                    <i class="fas fa-edit text-warning me-2"></i> Update Details
                                                </button>
                                            </li>
                                            @if (supplier.Status == "Requested")
                                            {
                                                <li>
                                                    <form asp-action="Approve" asp-route-id="@supplier.SupplierId" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="dropdown-item py-2 text-success fw-bold">
                                                            <i class="fas fa-check-circle me-2"></i> Approve Request
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <form asp-action="Delete" asp-route-id="@supplier.SupplierId" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item py-2 text-danger" onclick="return confirm('Archive this request?')">
                                                        <i class="fas fa-trash-alt me-2"></i> Delete Request
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ================= MODALS ================= -->

<!-- Create Request Modal -->
<div class="modal fade modal-modern" id="createSupplierModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content" style="border-radius: 20px;">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">New Delivery Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="createSupplierForm" asp-action="Create" method="post">
                <div class="modal-body p-4">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="bg-light p-3 rounded-4 mb-3">
                                <h6 class="fw-bold mb-3">Vendor Details</h6>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-muted">SUPPLIER NAME</label>
                                    <input name="SupplierName" class="form-control" placeholder="Company Name" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-muted">EMAIL ADDRESS</label>
                                    <input name="Email" type="email" class="form-control" placeholder="sales@vendor.com" required />
                                </div>
                                <div class="mb-0">
                                    <label class="form-label small fw-bold text-muted">UNIT PRICE (AVG)</label>
                                    <input name="UnitPrice" type="number" step="0.01" class="form-control" value="0.00" required />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <h6 class="fw-bold mb-3">Request Payload</h6>
                            <div class="row g-2 mb-3">
                                <div class="col-md-7">
                                    <input type="text" id="newSupplierProductName" class="form-control" placeholder="Product to request..." />
                                </div>
                                <div class="col-md-3">
                                    <input type="number" id="newSupplierQuantity" class="form-control" placeholder="Qty" min="1" />
                                </div>
                                <div class="col-md-2">
                                    <button type="button" id="addSupplierItemBtn" class="btn btn-primary w-100"><i class="fas fa-plus"></i></button>
                                </div>
                            </div>

                            <div class="table-responsive border rounded-4 mb-3" style="max-height: 200px;">
                                <table class="table table-sm align-middle mb-0">
                                    <thead class="bg-white sticky-top">
                                        <tr>
                                            <th>Item Name</th>
                                            <th>Quantity</th>
                                            <th class="text-end"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="newSupplierItemsBody"></tbody>
                                </table>
                            </div>
                            <div id="newSupplierLineItemInputs" style="display:none;"></div>

                            <div class="mb-0">
                                <label class="form-label small fw-bold text-muted">NOTES / DESCRIPTION</label>
                                <textarea name="Description" class="form-control" rows="2" placeholder="Addition delivery instructions..."></textarea>
                            </div>
                            <textarea name="ProductsAndQuantities" id="newSupplierProductsAndQuantities" style="display:none;"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success px-5" style="background: #10b981; border: none; font-weight: 700;">Submit Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Request Modal -->
<div class="modal fade modal-modern" id="editSupplierModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content" style="border-radius: 20px;">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Update Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editSupplierForm" asp-action="Edit" method="post">
                <input type="hidden" id="editSupplierId" name="SupplierId" />
                <input type="hidden" id="editSupplierStatus" name="Status" />
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="bg-light p-3 rounded-4 mb-3">
                                <h6 class="fw-bold mb-3">Vendor Details</h6>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-muted">SUPPLIER NAME</label>
                                    <input id="editSupplierName" name="SupplierName" class="form-control" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-muted">EMAIL ADDRESS</label>
                                    <input id="editSupplierEmail" name="Email" type="email" class="form-control" required />
                                </div>
                                <div class="mb-0">
                                    <label class="form-label small fw-bold text-muted">UNIT PRICE</label>
                                    <input id="editSupplierUnitPrice" name="UnitPrice" type="number" step="0.01" class="form-control" required />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <h6 class="fw-bold mb-3">Requested Items</h6>
                            <div class="row g-2 mb-3">
                                <div class="col-md-7">
                                    <input type="text" id="editSupplierProductName" class="form-control" placeholder="Add more products..." />
                                </div>
                                <div class="col-md-3">
                                    <input type="number" id="editSupplierQuantity" class="form-control" placeholder="Qty" min="1" />
                                </div>
                                <div class="col-md-2">
                                    <button type="button" id="editAddSupplierItemBtn" class="btn btn-primary w-100"><i class="fas fa-plus"></i></button>
                                </div>
                            </div>

                            <div class="table-responsive border rounded-4 mb-3" style="max-height: 200px;">
                                <table class="table table-sm align-middle mb-0">
                                    <thead class="bg-white sticky-top">
                                        <tr>
                                            <th>Item Name</th>
                                            <th>Quantity</th>
                                            <th class="text-end"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="editSupplierItemsBody"></tbody>
                                </table>
                            </div>
                            <div id="editSupplierLineItemInputs" style="display:none;"></div>

                            <div class="mb-0">
                                <label class="form-label small fw-bold text-muted">DESCRIPTION</label>
                                <textarea id="editSupplierDescription" name="Description" class="form-control" rows="2"></textarea>
                            </div>
                            <textarea name="ProductsAndQuantities" id="editSupplierProductsAndQuantities" style="display:none;"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-5" style="background: #215B8B; border: none; font-weight: 700;">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/suppliers-index.js" asp-append-version="true"></script>
}
