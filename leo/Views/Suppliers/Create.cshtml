@using System.Text.Json
@model leo.ViewModels.SupplierCreateViewModel

@{
    ViewData["Title"] = "Create Supplier";
}



<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <form asp-action="Create" method="post" class="bg-light p-4 rounded shadow-sm form-container">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="container">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-group">
                                <label asp-for="SupplierName" class="form-label">Suppliers</label>
                                <input asp-for="SupplierName" class="form-control shadow-sm" />
                                <span asp-validation-for="SupplierName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <div class="form-group">
                                <label asp-for="Email" class="form-label">Email</label>
                                <input asp-for="Email" type="email" class="form-control shadow-sm" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-group">
                                <label asp-for="UnitPrice" class="form-label">Unit Price</label>
                                <input asp-for="UnitPrice" type="number" min="0.01" step="0.01" class="form-control shadow-sm" placeholder="Enter unit price" />
                                <span asp-validation-for="UnitPrice" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <label class="form-label mb-0">Requested Products &amp; Quantities</label>
                            <button type="button"
                                    id="openAddItemModal"
                                    class="btn btn-success"
                                    data-bs-toggle="modal"
                                    data-bs-target="#addItemModal"
                                    data-toggle="modal"
                                    data-target="#addItemModal">
                                Add Item
                            </button>
                        </div>
                        <span asp-validation-for="LineItems" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <div class="table-responsive">
                            <table class="table table-sm table-striped align-middle mb-2">
                                <thead>
                                    <tr>
                                        <th style="width: 70%;">Product</th>
                                        <th style="width: 20%;">Qty</th>
                                        <th style="width: 10%;"></th>
                                    </tr>
                                </thead>
                                <tbody id="lineItemsBody"></tbody>
                            </table>
                        </div>
                        <div id="lineItemsInputs"></div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="ProductsAndQuantities" class="form-label">Summary</label>
                        <textarea asp-for="ProductsAndQuantities"
                                  id="productsAndQuantities"
                                  class="form-control shadow-sm custom-textarea"
                                  rows="10"
                                  placeholder="Product Name | Quantity"
                                  readonly></textarea>
                    </div>

                    <div class="form-group">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control shadow-sm" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <input type="submit" value="Save" class="btn btn-primary shadow" />
                        <a asp-action="Index" class="btn btn-outline-secondary shadow">Back to List</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="addItemModal" tabindex="-1" aria-labelledby="addItemModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addItemModalLabel">Add Requested Item</h5>
                <button type="button"
                        class="close btn-close"
                        data-bs-dismiss="modal"
                        data-dismiss="modal"
                        aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="modalProductName" class="form-label">Product</label>
                    <input type="text" id="modalProductName" class="form-control" placeholder="Enter product name" maxlength="200" />
                    <div class="invalid-feedback">Product name is required.</div>
                </div>
                <div class="mb-0">
                    <label for="modalQuantity" class="form-label">Quantity</label>
                    <input type="number" id="modalQuantity" class="form-control" placeholder="Enter quantity" min="1" />
                    <div class="invalid-feedback">Quantity must be at least 1.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmAddItem">Add</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        (function () {
            const initialItems = @Html.Raw(JsonSerializer.Serialize(Model.LineItems ?? new List<leo.ViewModels.SupplierLineItemViewModel>()));

            const lineItemsBody = document.getElementById('lineItemsBody');
            const lineItemsInputs = document.getElementById('lineItemsInputs');
            const summaryTextarea = document.getElementById('productsAndQuantities');
            const openAddItemModal = document.getElementById('openAddItemModal');

            const modalEl = document.getElementById('addItemModal');
            const modalProductName = document.getElementById('modalProductName');
            const modalQuantity = document.getElementById('modalQuantity');
            const confirmAddItem = document.getElementById('confirmAddItem');

            const items = (initialItems || []).map(i => ({
                productName: (i.productName || i.ProductName || '').toString(),
                quantity: Number(i.quantity || i.Quantity || 0)
            })).filter(i => i.productName.trim().length > 0 && i.quantity > 0);

            function normalizeName(name) {
                return (name || '').trim();
            }

            function escapeHtml(value) {
                const div = document.createElement('div');
                div.innerText = value;
                return div.innerHTML;
            }

            function findIndexByProductName(name) {
                const needle = normalizeName(name).toLowerCase();
                return items.findIndex(x => normalizeName(x.productName).toLowerCase() === needle);
            }

            function buildSummary() {
                if (items.length === 0) return '';
                const lines = ['Product Name | Quantity'];
                for (const item of items) {
                    lines.push(`${normalizeName(item.productName)} | ${item.quantity}`);
                }
                return lines.join('\n');
            }

            function render() {
                lineItemsBody.innerHTML = '';
                lineItemsInputs.innerHTML = '';

                items.forEach((item, idx) => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td>${escapeHtml(normalizeName(item.productName))}</td>
                        <td>${item.quantity}</td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-danger" data-index="${idx}">Remove</button>
                        </td>
                    `;
                    lineItemsBody.appendChild(tr);

                    const nameInput = document.createElement('input');
                    nameInput.type = 'hidden';
                    nameInput.name = `LineItems[${idx}].ProductName`;
                    nameInput.value = normalizeName(item.productName);
                    lineItemsInputs.appendChild(nameInput);

                    const qtyInput = document.createElement('input');
                    qtyInput.type = 'hidden';
                    qtyInput.name = `LineItems[${idx}].Quantity`;
                    qtyInput.value = item.quantity.toString();
                    lineItemsInputs.appendChild(qtyInput);
                });

                summaryTextarea.value = buildSummary();
            }

            function setInvalid(el, invalid) {
                el.classList.toggle('is-invalid', invalid);
            }

            function showAddItemModal() {
                if (window.bootstrap && bootstrap.Modal) {
                    bootstrap.Modal.getOrCreateInstance(modalEl).show();
                    return;
                }

                if (window.jQuery && typeof window.jQuery.fn.modal === 'function') {
                    window.jQuery(modalEl).modal('show');
                }
            }

            function hideAddItemModal() {
                if (window.bootstrap && bootstrap.Modal) {
                    bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                    return;
                }

                if (window.jQuery && typeof window.jQuery.fn.modal === 'function') {
                    window.jQuery(modalEl).modal('hide');
                }
            }

            function validateModalInputs() {
                const name = normalizeName(modalProductName.value);
                const qty = Number(modalQuantity.value);

                const invalidName = !name;
                const invalidQty = !Number.isFinite(qty) || qty < 1;

                setInvalid(modalProductName, invalidName);
                setInvalid(modalQuantity, invalidQty);

                return !(invalidName || invalidQty);
            }

            confirmAddItem.addEventListener('click', function () {
                if (!validateModalInputs()) return;

                const name = normalizeName(modalProductName.value);
                const qty = Number(modalQuantity.value);

                const existingIndex = findIndexByProductName(name);
                if (existingIndex >= 0) {
                    items[existingIndex].quantity += qty;
                } else {
                    items.push({ productName: name, quantity: qty });
                }

                render();

                modalProductName.value = '';
                modalQuantity.value = '';
                setInvalid(modalProductName, false);
                setInvalid(modalQuantity, false);

                hideAddItemModal();
            });

            openAddItemModal?.addEventListener('click', function (e) {
                e.preventDefault();
                showAddItemModal();
            });

            modalEl.addEventListener('shown.bs.modal', function () {
                modalProductName.focus();
            });

            modalEl.addEventListener('hidden.bs.modal', function () {
                modalProductName.value = '';
                modalQuantity.value = '';
                setInvalid(modalProductName, false);
                setInvalid(modalQuantity, false);
            });

            if (window.jQuery) {
                window.jQuery(modalEl).on('shown.bs.modal', function () {
                    modalProductName.focus();
                });

                window.jQuery(modalEl).on('hidden.bs.modal', function () {
                    modalProductName.value = '';
                    modalQuantity.value = '';
                    setInvalid(modalProductName, false);
                    setInvalid(modalQuantity, false);
                });
            }

            lineItemsBody.addEventListener('click', function (e) {
                const btn = e.target.closest('button[data-index]');
                if (!btn) return;

                const idx = Number(btn.getAttribute('data-index'));
                if (!Number.isFinite(idx) || idx < 0 || idx >= items.length) return;

                items.splice(idx, 1);
                render();
            });

            render();
        })();
    </script>
}


